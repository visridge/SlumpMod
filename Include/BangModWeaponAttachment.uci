// BangMod Weapon Attachment Netcode Optimization
// Maximum performance: 120Hz for all weapon attachments

// Netcode optimization: High priority replication for all weapon attachments
event float GetNetPriority(Actor Viewer, vector ViewLocation, float ViewDist)
{
	// Always use maximum priority and frequency for weapon attachments
	NetUpdateFrequency = 120.0;
	return 5000.0;
}

// Override AttachTo so we can apply parry box overrides AFTER the base sets translation.
// AOCWeaponAttachment.AttachTo sets ParryComponent translation at the very end, which
// overwrites anything done in AOCSetCharacterClassFromInfo on the pawn. This hook fires last.
simulated function AttachTo(UTPawn OwnerPawn)
{
	super.AttachTo(OwnerPawn);
	if (AOCOwner == none)
		return;
	if (!class'BangModAOCDuelPlayerController'.default.bBangModParryBox)
	{
		// Revert to vanilla AOC parry box
		AOCOwner.ParryComponent.SetScale3D(vect(0.1, 0.17, 0.35));
		AOCOwner.ParryComponent.SetTranslation(vect(30, 0, -30));
	}
	else if (class'BangModAOCDuelPlayerController'.default.bSkeletalParry)
	{
		// Skeletal parry: hitbox wraps the full player model instead of a directional shield
		AOCOwner.ParryComponent.SetScale3D(vect(0.18, 0.17, 0.35));
		AOCOwner.ParryComponent.SetTranslation(vect(10, 5, -28));
	}
}

// Default properties
NetUpdateFrequency=120
ParryTracersLength=67.0
