exec function AdminToggleParryBox(optional bool bEnable = true)
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminToggleParryBox(bEnable);
}

reliable server function S_AdminToggleParryBox(bool bEnable) {
	if (!IsAdmin())
		return;
	// Must set on the class default — pawn reads class'BangModAOCDuelPlayerController'.default.bBangModParryBox
	class'BangModAOCDuelPlayerController'.default.bBangModParryBox = bEnable;
	class'BangModAOCDuelPlayerController'.static.StaticSaveConfig();
	ClientSyncParryBoxSettings(class'BangModAOCDuelPlayerController'.default.bBangModParryBox,
		class'BangModAOCDuelPlayerController'.default.bSkeletalParry);
	if (bEnable)
		S_AdminBroadcastMessage("BangMod parry box ENABLED (respawn to apply)", false);
	else
		S_AdminBroadcastMessage("BangMod parry box DISABLED - using vanilla AOC parry box (respawn to apply)", false);
}

