var BangModCustomizationContent CustomizationBaseDummy;
var float InterpYaw;
var float InterpPitch;

var bool bShowDeathMessages;
var bool bPCShowHitTime;
var bool bShowHitTime;

var bool bShowGroundSpeed;

var float fLastFeintTime;  // Track when last feint was attempted to prevent spam

var bool bShownOptimizationTip;  // Track if we've shown the optimization tip to this player

// Camera shake configuration
var globalconfig bool bDisableScreenShake;  // Disable all camera shake effects (flinch, dazed, hits)

// Proximity Voice Chat
var globalconfig float ProximityChatDistance;  // Distance in UU where players can hear each other
var globalconfig bool bEnableProximityChat;     // Master toggle for proximity chat
var bool bIsTalking;  // Is local player currently talking
var array<AOCPRI> NearbyTalkers;  // List of PRIs currently talking within range

// Parry box toggle
var globalconfig bool bBangModParryBox;  // When true, use BangMod parry box values; when false, revert to vanilla AOC defaults
var globalconfig bool bSkeletalParry;    // When true, parry hitbox wraps the full player model (skeletal parry) instead of directional shield-style
var globalconfig bool bDisableButtParries;  // When true, attacks from behind the defender cannot be parried

// Collision bubble radius (OuterCylinder)
var globalconfig float fBangModCollisionRadius;  // Radius of the player collision bubble; vanilla AOC default is 39.0

// BANGMOD: Persisted client-clock offset (server-only) for the hit-trade timestamp system.
// The offset is accumulated on the pawn (BangModPawn.fClientClockOffset); we stash it here when
// the pawn dies and re-seed the next pawn on Possess, so the system isn't cold (falling back to
// pure ping reconstruction) for the first hit or two after every respawn.
var float fPersistedClientClockOffset;
var bool  bPersistedClockOffsetInit;

// BANGMOD: First-person spectator (see the FIRST-PERSON SPECTATOR block further down).
var bool    bBangModFPSpectate;      // desired perspective while following a player (true = first person)
var AOCPawn BangModFPObservedPawn;   // pawn we currently have first-person-observer state applied to
var AOCPawn BangModHUDPawn;          // pawn the spectator health/stamina HUD is currently showing
var AOCPawn BangModPerspectivePawn;  // pawn we have already established a camera perspective for
var float   fBangModNextFPRetry;     // WorldInfo.TimeSeconds gate for re-poking a pawn to rebuild its 1P mesh
var AOCPawn BangModFPBlockLoggedPawn; // pawn whose first-person refusal we have already logged

// BANGMOD: health/stamina bar enforcement (see BangModEnforceLifeBars)
var AOCPawn BangModLifeBarPawn;          // pawn the bars are currently showing
var float   fBangModNextLifeBarAssert;   // throttle for re-asserting bar visibility
var int     iBangModLastHealthShown;
var float   fBangModLastStaminaShown;

// BANGMOD: spectator field-of-view lock (see BangModEnforceSpectateFOV)
var float   fBangModFOVCaught;       // last wrong FOV value we corrected while spectating
var name    nBangModFOVCaughtWhere;  // which hook caught it -- reported by FPSpectateDebug

// BANGMOD: admin-only pause control (ported from NateMod). Pausing is restricted
// to admins; unpausing is also admin-only and runs a short 3-2-1-GO countdown so
// players get a heads-up before the action resumes.
var bool  bIsPaused;              // true while an admin has the game paused
var int   UnpauseCountdownTime;   // countdown start value (default 3)


simulated function SetAllParryBoxClassDefaults(bool bEnableBangMod, bool bEnableSkeletal)
{
	class'BangModAOCDuelPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModAOCDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModCDWDuelPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModCDWDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModCTFPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModCTFPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModFFAPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModFFAPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModKOTHPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModKOTHPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModLTSPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModLTSPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModTDPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModTDPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModTOPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModTOPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModTUTPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModTUTPlayerController'.default.bSkeletalParry = bEnableSkeletal;
}

simulated function ApplyParryBoxSettingsToCurrentPawn()
{
	local AOCPawn CurrentPawn;
	local vector ParryBoxTranslation;

	CurrentPawn = AOCPawn(Pawn);
	if (CurrentPawn == none || CurrentPawn.ParryComponent == none || CurrentPawn.PawnFamily == none)
	{
		return;
	}

	if (!class'BangModAOCDuelPlayerController'.default.bBangModParryBox)
	{
		CurrentPawn.ParryComponent.SetScale3D(vect(0.1, 0.17, 0.35));
		CurrentPawn.ParryComponent.SetTranslation(vect(30, 0, -30));
		return;
	}

	if (class'BangModAOCDuelPlayerController'.default.bSkeletalParry)
	{
		CurrentPawn.ParryComponent.SetScale3D(vect(0.18, 0.17, 0.35));
		CurrentPawn.ParryComponent.SetTranslation(vect(10, 5, -28));
		return;
	}

	ParryBoxTranslation = CurrentPawn.PawnFamily.ParryBoxTranslation;
	if (AOCWeaponAttachment(CurrentPawn.CurrentWeaponAttachment) != none)
	{
		ParryBoxTranslation += AOCWeaponAttachment(CurrentPawn.CurrentWeaponAttachment).ParryBoxTranslation;
	}

	CurrentPawn.ParryComponent.SetScale3D(CurrentPawn.PawnFamily.ParryBoxScale);
	CurrentPawn.ParryComponent.SetTranslation(ParryBoxTranslation);
}

reliable client function ClientSyncParryBoxSettings(bool bEnableBangMod, bool bEnableSkeletal)
{
	bBangModParryBox = bEnableBangMod;
	bSkeletalParry = bEnableSkeletal;
	SetAllParryBoxClassDefaults(bEnableBangMod, bEnableSkeletal);
	ApplyParryBoxSettingsToCurrentPawn();
}

simulated function SetAllCollisionRadiusClassDefaults(float Radius)
{
	class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModCDWDuelPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModCTFPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModFFAPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModKOTHPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModLTSPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModTDPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModTOPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModTUTPlayerController'.default.fBangModCollisionRadius = Radius;
}

simulated function ApplyCollisionRadiusToCurrentPawn()
{
	local BangModAOCDuelPawn BMP;

	BMP = BangModAOCDuelPawn(Pawn);
	if (BMP == none || BMP.OuterCylinderComp == none)
		return;

	BMP.OuterCylinderComp.SetCylinderSize(class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius, 65.0);
}

reliable client function ClientSyncCollisionRadius(float Radius)
{
	fBangModCollisionRadius = Radius;
	SetAllCollisionRadiusClassDefaults(Radius);
	ApplyCollisionRadiusToCurrentPawn();
}

// Ensure BangMod uses its customization class everywhere
simulated event PostBeginPlay()
{
	super.PostBeginPlay();
	if (CustomizationClass != class'BangModCustomization')
	{
		CustomizationClass = class'BangModCustomization';
	}

	// BANGMOD: follow players in first person by default; Space toggles back to
	// the vanilla orbit follow. Set here rather than in state Spectating.BeginState
	// so the choice sticks for the whole session instead of resetting every time
	// the player re-enters spectate.
	bBangModFPSpectate = true;
}

