exec function AdminSetCollisionRadius(float NewRadius)
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminSetCollisionRadius(NewRadius);
}

reliable server function S_AdminSetCollisionRadius(float NewRadius) {
	local AOCPlayerController PC;

	if (!IsAdmin())
		return;

	// Clamp to a sane range to prevent griefing (1 to 200)
	NewRadius = FClamp(NewRadius, 1.0, 200.0);

	class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius = NewRadius;
	class'BangModAOCDuelPlayerController'.static.StaticSaveConfig();

	// Sync all connected players
	foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
	{
		if (BangModAOCDuelPlayerController(PC) != none)
			BangModAOCDuelPlayerController(PC).ClientSyncCollisionRadius(NewRadius);
	}

	S_AdminBroadcastMessage("Collision bubble radius set to" @ NewRadius @ "(respawn to apply)", false);
}

// CE Autoskip: auto-fires "ce skip" when TO timer reaches 5 seconds
exec function AdminCEAutoskip()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminCEAutoskip();
}

reliable server function S_AdminCEAutoskip() {
	local BangModTO TOGame;

	if (!IsAdmin())
		return;

	TOGame = BangModTO(WorldInfo.Game);
	if (TOGame == none) {
		ClientDisplayConsoleMessage("CE Autoskip only works in Team Objective.");
		return;
	}

	TOGame.bCEAutoskipEnabled = !TOGame.bCEAutoskipEnabled;
	TOGame.bCEAutoskipFired = false;
	if (TOGame.bCEAutoskipEnabled)
		S_AdminBroadcastMessage("CE Autoskip ENABLED (auto-skip at 5s)", false);
	else
		S_AdminBroadcastMessage("CE Autoskip DISABLED", false);
}

// Option A: Reset ALL physics volumes to default friction (nuclear)
exec function AdminResetAllTraction()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminResetAllTraction();
}

reliable server function S_AdminResetAllTraction() {
	local PhysicsVolume PV;
	local int Count;

	if (!IsAdmin())
		return;

	foreach AllActors(class'PhysicsVolume', PV)
	{
		if (PV.GroundFriction != 8.0)
		{
			PV.GroundFriction = 8.0;
			Count++;
		}
	}
	S_AdminBroadcastMessage("Reset traction on" @ Count @ "physics volumes (Option A - all volumes)", false);
}

// Option C: Reset only non-water low-friction volumes (selective)
exec function AdminResetIceTraction()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminResetIceTraction();
}

reliable server function S_AdminResetIceTraction() {
	local PhysicsVolume PV;
	local int Count;

	if (!IsAdmin())
		return;

	foreach AllActors(class'PhysicsVolume', PV)
	{
		if (PV.GroundFriction < 8.0 && !PV.bWaterVolume)
		{
			PV.GroundFriction = 8.0;
			Count++;
		}
	}
	S_AdminBroadcastMessage("Reset ice traction on" @ Count @ "physics volumes (Option C - non-water only)", false);
}

reliable server function S_SendF10Message() {
	ReceiveChatMessage("You will implode in 1 second.", EFAC_ALL, false, false, ,false);
}

exec function FOV(float F) {
	if((F >= 60.0 && F <= 165.0) || PlayerReplicationInfo.bOnlySpectator) {
		DefaultFOV = F;
		DesiredFOV = DefaultFOV;
		FOVAngle   = DefaultFOV;

		// Persist BEFORE the PlayerCamera branch.
		//
		// Everything that later RESTORES the field of view -- AOCPlayerController's
		// FixFOV() and ResetFOV(), and AOCPawn on spawn (AOCPawn.uc:9080) -- reads
		// MyFOV. The previous version returned early whenever a PlayerCamera existed
		// and so never stored it, which is how a custom FOV snaps back to the
		// configured value (typically 120) the moment any of those run.
		if (IsLocalPlayerController()) {
			MyFOV = F;
			default.MyFOV = F;
			StaticSaveConfig();
		}

		if (PlayerCamera != None) {
			PlayerCamera.SetFOV( F );
		}
	}
}

