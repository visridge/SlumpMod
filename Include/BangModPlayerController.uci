		S_AdminBroadcastMessage("CE Autoskip ENABLED (auto-skip at 5s)", false);
	else
		S_AdminBroadcastMessage("CE Autoskip DISABLED", false);
}

// Option A: Reset ALL physics volumes to default friction (nuclear)
exec function AdminResetAllTraction()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminResetAllTraction();
}

reliable server function S_AdminResetAllTraction() {
	local PhysicsVolume PV;
	local int Count;

	if (!IsAdmin())
		return;

	foreach AllActors(class'PhysicsVolume', PV)
	{
		if (PV.GroundFriction != 8.0)
		{
			PV.GroundFriction = 8.0;
			Count++;
		}
	}
	S_AdminBroadcastMessage("Reset traction on" @ Count @ "physics volumes (Option A - all volumes)", false);
}

// Option C: Reset only non-water low-friction volumes (selective)
exec function AdminResetIceTraction()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminResetIceTraction();
}

reliable server function S_AdminResetIceTraction() {
	local PhysicsVolume PV;
	local int Count;

	if (!IsAdmin())
		return;

	foreach AllActors(class'PhysicsVolume', PV)
	{
		if (PV.GroundFriction < 8.0 && !PV.bWaterVolume)
		{
			PV.GroundFriction = 8.0;
			Count++;
		}
	}
	S_AdminBroadcastMessage("Reset ice traction on" @ Count @ "physics volumes (Option C - non-water only)", false);
}

