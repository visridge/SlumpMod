// Allow sprint attack for the bastard sword without enabling it for the rest of Man at Arms.
exec function StartFire(optional byte FireModeNum)
{
	local AOCPawn AOCP;
	local bool bCanUseSprintAttack;

	AOCP = AOCPawn(Pawn);

	if (WorldInfo.Pauser == PlayerReplicationInfo)
	{
		SetPause(false);
		return;
	}

	if (AOCP != none)
	{
		bCanUseSprintAttack = AOCP.StateVariables.bIsSprinting
			&& !AOCP.StateVariables.bIsManualJumpDodge
			&& FireModeNum == Attack_Sprint
			&& !AOCP.StateVariables.bIsAttacking
			&& AOCP.StateVariables.bCanSprintAttack
			&& !ScriptBlockedInputs[EINBLOCK_AttackSprint]
			// && ((AOCP.bIsSprintMaxSpeed && AOCP.PawnFamily.bCanSprintAttack) || CanBastardSwordSprintAttack(AOCP));
			&& AOCP.bIsSprintMaxSpeed
			&& AOCP.PawnFamily.bCanSprintAttack;

		if (bCanUseSprintAttack)
		{
			if (!AOCP.HasEnoughStamina(20))
			{
				return;
			}
		}
		else
		{
			if (FireModeNum == Attack_Sprint)
			{
				return;
			}
		}

		if (FireModeNum == Attack_Parry && ScriptBlockedInputs[EINBLOCK_Block]
		  || FireModeNum == Attack_Slash && ScriptBlockedInputs[EINBLOCK_AttackSlash]
		  || FireModeNum == Attack_Stab && ScriptBlockedInputs[EINBLOCK_AttackStab]
		  || FireModeNum == Attack_Overhead && ScriptBlockedInputs[EINBLOCK_AttackOverhead]
		  || FireModeNum == Attack_Shove && ScriptBlockedInputs[EINBLOCK_AttackShove])
		{
			return;
		}

		if (AOCP.StateVariables.bCanParry && FireModeNum == Attack_Parry)
		{
			LastAttack = Attack_Parry;
			LastFireTime = WorldInfo.TimeSeconds;
			AOCP.StartFire(Attack_Parry);
			return;
		}

		if (FireModeNum == Attack_Shove && !AOCP.HasEnoughStamina(AOCP.PawnFamily.iKickcost))
		{
			AOCP.PlayLowStaminaGrunt();
			return;
		}

		if (AOCP.DodgeSM.bQueueDodgeAttack)
		{
			LastAttack = EAttack(FireModeNum);
			LastFireTime = WorldInfo.TimeSeconds;
			AOCP.DodgeSM.QueueAttack(FireModeNum);
			return;
		}

		if (!bCinematicMode && AOCP.StateVariables.bCanAttack)
		{
			LastAttack = EAttack(FireModeNum);
			LastFireTime = WorldInfo.TimeSeconds;
			AOCP.StartFire(FireModeNum);
		}

		return;
	}

	super.StartFire(FireModeNum);
}

// Override ProcessViewRotation to remove turn cap during parry counters
function ProcessViewRotation( float DeltaTime, out Rotator out_ViewRotation, Rotator DeltaRot )
{
	local float MaxTurnSpeed;
	local float MaxVertTurnSpeed;
	local bool bInAttackFlow;
	local bool bSavedAttacking;
	local float AttackH, AttackV;

	if( PreventTurning )
        return;
	if( PlayerCamera != None )
	{
		PlayerCamera.ProcessViewRotation( DeltaTime, out_ViewRotation, DeltaRot );
	}
	
	if(ScriptBlockedInputs[EINBLOCK_Rotate])
	{
		DeltaRot.Yaw = 0;
		DeltaRot.Pitch = 0;
		DeltaRot.Roll = 0;	
	}
	else if ( AOCPawn(Pawn) != None )
	{	
		// BANGMOD turncap desync fix. StateVariables is a *replicated* struct, so on a dedicated
		// server the server's snapshot of bIsAttacking periodically clobbers the owning client's
		// locally-predicted value. During rapid combos that bool can read false for a frame or two
		// between chained attacks; on those frames the gate below skipped the yaw clamp entirely
		// and an uncapped mouse delta was applied and then sent to (and trusted by) the server ->
		// the "turncap comes unbound / spin" desync. The weapon's simulated state
		// (Windup/Release/Transition) is driven by the client's own animation timers and does NOT
		// suffer that clobber, so use it as a stable fallback to keep the cap bound for the whole
		// combo. Melee only (ranged draw/reload has its own handling below).
		bInAttackFlow = Pawn.Weapon != none && AOCMeleeWeapon(Pawn.Weapon) != none
			&& (AOCWeapon(Pawn.Weapon).IsInState('Windup')
				|| AOCWeapon(Pawn.Weapon).IsInState('Release')
				|| AOCWeapon(Pawn.Weapon).IsInState('Transition'));

		if ( (AOCPawn(Pawn).StateVariables.bIsAttacking || bInAttackFlow) && LimitTurnSpeed  && Pawn.Weapon != none && AOCWeapon(Pawn.Weapon) != none)
		{
			MaxTurnSpeed = AOCWeapon(Pawn.Weapon).GetHorizontalRotateSpeed();
			MaxVertTurnSpeed = AOCWeapon(Pawn.Weapon).GetVerticalRotateSpeed();

			// If the replicated bool flickered false mid-combo, GetHorizontalRotateSpeed() returns
			// the *free-look* speed (its !bIsAttacking branch).  Call GetHorizontalRotateSpeed /
			// GetVerticalRotateSpeed again with a temporary bIsAttacking=true so per-firemode
			// overrides in subclasses are still respected during the flicker.  The FMax() against
			// the raw vars keeps a safe floor in case the override returns 0.
			if (bInAttackFlow && !AOCPawn(Pawn).StateVariables.bIsAttacking)
			{
				bSavedAttacking = AOCPawn(Pawn).StateVariables.bIsAttacking;
				AOCPawn(Pawn).StateVariables.bIsAttacking = true;
				AttackH = AOCWeapon(Pawn.Weapon).GetHorizontalRotateSpeed();
				AttackV = AOCWeapon(Pawn.Weapon).GetVerticalRotateSpeed();
				AOCPawn(Pawn).StateVariables.bIsAttacking = bSavedAttacking;

				if (AOCWeapon(Pawn.Weapon).CurrentFireMode == Attack_Sprint)
				{
					MaxTurnSpeed    = FMax(AttackH, AOCWeapon(Pawn.Weapon).SprintAttackHorizRotateSpeed);
					MaxVertTurnSpeed = FMax(AttackV, AOCWeapon(Pawn.Weapon).SprintAttackVerticalRotateSpeed);
				}
				else
				{
					MaxTurnSpeed    = FMax(AttackH, AOCWeapon(Pawn.Weapon).AttackHorizRotateSpeed);
					MaxVertTurnSpeed = FMax(AttackV, AOCWeapon(Pawn.Weapon).VerticalRotateSpeed);
				}
			}
			
			// BANGMOD: Loosen turn cap during parry animation - use Holy Water Sprinkler esque speeds
			if (AOCPawn(Pawn).StateVariables.bIsParrying)
			{
				MaxTurnSpeed = 75000.0;
				MaxVertTurnSpeed = 75000.0;
			}
			else
			{
				if ( AOCPawn(Pawn).StateVariables.bIsSprinting )
					MaxTurnSpeed = FMin(MaxTurnSpeed, MaxSprintTurnSpeed);
				
				if ( AOCPawn(Pawn).Weapon.IsInState('Reload') && AOCWeapon_Crossbow(AOCPawn(Pawn).Weapon) != none || AOCWeapon_PaviseShield(AOCPawn(Pawn).Weapon) != none)
				{
					MaxTurnSpeed = 0.0f;
					MaxVertTurnSpeed = 0.0f;
				}
			}
			
			if( AOCWeapon(Pawn.Weapon).IsInState( 'Windup' ) || AOCWeapon(Pawn.Weapon).IsInState( 'Release' ) || AOCWeapon(Pawn.Weapon).IsInState( 'Transition' ) || ( AOCPawn(Pawn).Weapon.IsInState('Reload') && AOCWeapon_Crossbow(AOCPawn(Pawn).Weapon) != none )
				|| (AOCPawn(Pawn).StateVariables.bIsAttacking && AOCPawn(Pawn).Weapon.CurrentFireMode == Attack_Sprint)
				|| AOCMeleeWeapon(Pawn.Weapon).bParryHitCounter)
			{
				if ( DeltaRot.Pitch >= 0 )
					DeltaRot.Pitch = FMin( DeltaRot.Pitch, MaxVertTurnSpeed * DeltaTime );
				else
					DeltaRot.Pitch = FMax( DeltaRot.Pitch, -MaxVertTurnSpeed * DeltaTime );
			}

			if ( DeltaRot.Yaw >= 0 )
				DeltaRot.Yaw = FMin( DeltaRot.Yaw, MaxTurnSpeed * DeltaTime);
			else
				DeltaRot.Yaw = FMax( DeltaRot.Yaw, -MaxTurnSpeed * DeltaTime);

			out_ViewRotation	+= DeltaRot;
			out_ViewRotation	 = LimitViewRotation(out_ViewRotation, -14000, 16383 );
		}
		else if(AOCWeapon_PaviseShield(AOCPawn(Pawn).Weapon) != none || AOCPawn(Pawn).PawnState == ESTATE_Execution)
		{
			if(AOCWeapon_PaviseShield(AOCPawn(Pawn).Weapon) != none)
			{
				out_ViewRotation.Pitch = 0;
			}
			
			DeltaRot.Yaw = 0;
			DeltaRot.Pitch = 0;
			DeltaRot.Roll = 0;
		}
		else
		{
			AOCPawn(Pawn).ProcessViewRotation( DeltaTime, out_ViewRotation, DeltaRot );
		}
		LastDeltaRot = DeltaRot;
	}
	else
	{
		out_ViewRotation += DeltaRot;
	}
}

// Override to prevent players from enabling ragdolls via console commands
exec function SetRagdollLimit(int NewLimit)
{
	// Always force to 0 regardless of what player requests
	MaxRagdolls = 0;
	default.MaxRagdolls = 0;
	
	// Clean up any existing ragdolls
	if (RagdolledPawns.Length > 0)
	{
		RemoveRagdolls(RagdolledPawns.Length);
	}
}

// Override to prevent ragdolls from being added in the first place
function AddRagdolledPawn(AOCPawn RagdolledPawn)
{
	// Immediately remove the ragdoll - don't add it to the list
	if (RagdolledPawn != none)
	{
		RagdolledPawn.LifeSpan = 0.1f;
	}
}

// Override Possess to enforce ragdoll limit and show optimization tip on first spawn
event Possess(Pawn inPawn, bool bVehicleTransition)
{
	super.Possess(inPawn, bVehicleTransition);

	// BANGMOD: Re-seed the client-clock offset carried from this player's previous pawn so the
	// hit-trade timestamp system starts warm instead of cold (pure ping reconstruction) for the
	// first hit or two after respawn. Offset is captured in PawnDied below. Server-only.
	if (Role == ROLE_Authority && bPersistedClockOffsetInit && BangModPawn(inPawn) != none)
		BangModPawn(inPawn).SeedClockOffset(fPersistedClientClockOffset);
	
	// Force ragdolls disabled on every spawn (catches players with read-only configs)
	ConsoleCommand("SetRagdollLimit 0");

	// Parry box settings live on the server class default and are read on the client when
	// pawns/attachments size the local debug box. Sync them on every possess so respawns and
	// late joins don't keep stale client-side defaults.
	// if (Role == ROLE_Authority)
	// {
	// 	ClientSyncParryBoxSettings(class'BangModAOCDuelPlayerController'.default.bBangModParryBox,
	// 		class'BangModAOCDuelPlayerController'.default.bSkeletalParry);
	// 	ClientSyncCollisionRadius(class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius);
	// }
	
	// Show optimization tip once when player first spawns
	if (!bShownOptimizationTip && Role == ROLE_Authority)
	{
		bShownOptimizationTip = true;
		SetTimer(2.0f, false, 'ShowOptimizationTip');
	}
}

// BANGMOD: Capture the dying pawn's accumulated client-clock offset so the next pawn can start
// warm (re-seeded in Possess). Runs before super so the pawn is still valid. Server-only.
function PawnDied(Pawn P)
{
	if (Role == ROLE_Authority && BangModPawn(P) != none && BangModPawn(P).bClientClockOffsetInit)
	{
		fPersistedClientClockOffset = BangModPawn(P).fClientClockOffset;
		bPersistedClockOffsetInit = true;
	}

	super.PawnDied(P);
}

// Send optimization tip as a server message that appears in chat
function ShowOptimizationTip()
{
	ReceiveChatMessage("=== Welcome to SlumpMod ===", EFAC_ALL, false, true, "#00FF00");
	ReceiveChatMessage("Join our discord at https://discord.gg/G4Zsm62z5J", EFAC_ALL, false, true, "#FFAA00");
	ReceiveChatMessage("disableScreenShake True - in console", EFAC_ALL, false, true, "#ffffff");
}

reliable server function bool IsAdmin() {
	return WorldInfo.Game.AccessControl.IsAdmin(self) || WorldInfo.NetMode == NM_Standalone;
}

reliable server function S_AdminBroadcastMessage(string Message, optional bool bShowName=true) {
	local AOCPlayerController PC;
	foreach WorldInfo.AllControllers(class'AOCPlayerController', PC) {
		if (bShowName)
			PC.ReceiveChatMessage(AOCPRI(PlayerReplicationInfo).GetHumanReadableName()$":"@Message, EFAC_ALL, false, false, ,false);
		else
			PC.ReceiveChatMessage(Message, EFAC_ALL, false, false, ,false);
	}
}

// Admin-only pause/unpause. Overrides the engine SetPause so a non-admin can
// neither pause (e.g. typing "pause" in the console) nor unpause the game.
function bool SetPause(bool bPause, optional delegate<CanUnpause> CanUnpauseDelegate=CanUnpause) {
	local bool bResult;
	if (bPause) {
		if (!IsAdmin()) {
			ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
			return false;
		}
		bFire = 0;
		bResult = WorldInfo.Game.SetPause(self, CanUnpauseDelegate);
		if (bResult) {
			PauseRumbleForAllPlayers();
			bIsPaused = true;
		}
	} else if (IsAdmin() && bIsPaused) {
		// Route through countdown instead of immediate unpause
		S_StartUnpauseCountdown();
	}
	return bResult;
}

// Explicit admin command to start the unpause countdown.
exec function UnPause() {
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_StartUnpauseCountdown();
}

reliable server function S_StartUnpauseCountdown() {
	if (!IsAdmin())
		return;
	if (!bIsPaused) {
		ClientDisplayConsoleMessage("The game is not currently paused.");
		return;
	}
	UnpauseCountdownTime = Default.UnpauseCountdownTime;
	S_AdminBroadcastMessage("Unpausing in...", false);
	WorldInfo.Game.ClearPause();
	PauseRumbleForAllPlayers(false);
	bIsPaused = false;
	UnpauseCountdownTick();
	SetTimer(1.0f, true, 'UnpauseCountdownTick');
}

function UnpauseCountdownTick() {
	if (UnpauseCountdownTime == 0) {
		S_AdminBroadcastMessage("GO!", false);
		ClearTimer('UnpauseCountdownTick');
	} else {
		S_AdminBroadcastMessage("    "$UnpauseCountdownTime$"...", false);
		UnpauseCountdownTime--;
	}
}

exec function AdminBroadcastMessage(String Message) {
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminBroadcastMessage(Message);
}

exec function AdminCoinFlip() {
	local int Coin;
	local string Result;
	local AOCPlayerController PC;

	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}

	Coin = Rand(2);
	if (Coin == 0)
		Result = "Heads";
	else
		Result = "Tails";

	foreach WorldInfo.AllControllers(class'AOCPlayerController', PC) {
		PC.ReceiveChatMessage(AOCPRI(PlayerReplicationInfo).GetHumanReadableName()@"flipped a coin:"@Result, EFAC_ALL, false, true, "#00FF00");
	}
}

