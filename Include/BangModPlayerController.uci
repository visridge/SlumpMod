var BangModCustomizationContent CustomizationBaseDummy;
var float InterpYaw;
var float InterpPitch;

var bool bShowDeathMessages;
var bool bPCShowHitTime;
var bool bShowHitTime;

var bool bShowGroundSpeed;

var float fLastFeintTime;  // Track when last feint was attempted to prevent spam

var bool bShownOptimizationTip;  // Track if we've shown the optimization tip to this player

// Camera shake configuration
var globalconfig bool bDisableScreenShake;  // Disable all camera shake effects (flinch, dazed, hits)

// Proximity Voice Chat
var globalconfig float ProximityChatDistance;  // Distance in UU where players can hear each other
var globalconfig bool bEnableProximityChat;     // Master toggle for proximity chat
var bool bIsTalking;  // Is local player currently talking
var array<AOCPRI> NearbyTalkers;  // List of PRIs currently talking within range

// Parry box toggle
var globalconfig bool bBangModParryBox;  // When true, use BangMod parry box values; when false, revert to vanilla AOC defaults
var globalconfig bool bSkeletalParry;    // When true, parry hitbox wraps the full player model (skeletal parry) instead of directional shield-style
var globalconfig bool bDisableButtParries;  // When true, attacks from behind the defender cannot be parried

// Collision bubble radius (OuterCylinder)
var globalconfig float fBangModCollisionRadius;  // Radius of the player collision bubble; vanilla AOC default is 39.0

// BANGMOD: Persisted client-clock offset (server-only) for the hit-trade timestamp system.
// The offset is accumulated on the pawn (BangModPawn.fClientClockOffset); we stash it here when
// the pawn dies and re-seed the next pawn on Possess, so the system isn't cold (falling back to
// pure ping reconstruction) for the first hit or two after every respawn.
var float fPersistedClientClockOffset;
var bool  bPersistedClockOffsetInit;

// BANGMOD: First-person spectator (see the FIRST-PERSON SPECTATOR block further down).
var bool    bBangModFPSpectate;      // desired perspective while following a player (true = first person)
var AOCPawn BangModFPObservedPawn;   // pawn we currently have first-person-observer state applied to
var AOCPawn BangModHUDPawn;          // pawn the spectator health/stamina HUD is currently showing
var AOCPawn BangModPerspectivePawn;  // pawn we have already established a camera perspective for
var float   fBangModNextFPRetry;     // WorldInfo.TimeSeconds gate for re-poking a pawn to rebuild its 1P mesh
var AOCPawn BangModFPBlockLoggedPawn; // pawn whose first-person refusal we have already logged

// BANGMOD: health/stamina bar enforcement (see BangModEnforceLifeBars)
var AOCPawn BangModLifeBarPawn;          // pawn the bars are currently showing
var float   fBangModNextLifeBarAssert;   // throttle for re-asserting bar visibility
var int     iBangModLastHealthShown;
var float   fBangModLastStaminaShown;

// BANGMOD: spectator field-of-view lock (see BangModEnforceSpectateFOV)
var float   fBangModFOVCaught;       // last wrong FOV value we corrected while spectating
var name    nBangModFOVCaughtWhere;  // which hook caught it -- reported by FPSpectateDebug

// BANGMOD: minimum client send rate (see BangModRestoreNetSpeed).
//   0 (or absent from the ini) = use the built-in default of 15000
//   negative                   = opt out entirely
// Deliberately NOT relying on globalconfig to deliver the default: measured on a
// live client this read back 0 even with iBangModMinNetSpeed=15000 in
// defaultproperties, the key absent from every ini, and no competing
// defaultproperties block in the including class. So 0 is treated as unset.
var globalconfig int iBangModMinNetSpeed;
var int iBangModMinNetSpeedFallback;  // plain var: config cannot zero this one
var float fBangModNextNetSpeedCheck;  // throttle for the tick-side assert
var name  nBangModNetSpeedBlock;      // why the last automatic attempt did nothing
var int   iBangModNetSpeedTries;      // how many times it has tried

// BANGMOD: spectator team lock (see BangModMayView)
var int     iBangModViewBlocks;      // times we refused an out-of-team view target
var name    nBangModViewBlockWhere;  // which hook refused it, for FPSpectateDebug

// BANGMOD: admin-only pause control (ported from NateMod). Pausing is restricted
// to admins; unpausing is also admin-only and runs a short 3-2-1-GO countdown so
// players get a heads-up before the action resumes.
var bool  bIsPaused;              // true while an admin has the game paused
var int   UnpauseCountdownTime;   // countdown start value (default 3)

// BANGMOD: inebriate on any map (see the block above ClientInebriate for the why).
// Declared up here because UnrealScript requires every var before the first function
// in the class body -- and this .uci is pasted straight into one.
var PostProcessChain BangModDrunkChain;   // ChivPostProcess_drunk, from defaultproperties
var bool bBangModDrunkChainAdded;         // true only when WE swapped the chain, so only we restore it

var bool bBangModVoiceTrace;              // VoiceTrace: print remote talking notifications
var globalconfig bool bBangModVoiceAutoRegister;  // sweep remote talkers into Steam's voice layer
var bool bBangModVoiceSweepArmed;


simulated function SetAllParryBoxClassDefaults(bool bEnableBangMod, bool bEnableSkeletal)
{
	class'BangModAOCDuelPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModAOCDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModCDWDuelPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModCDWDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModCTFPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModCTFPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModFFAPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModFFAPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModKOTHPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModKOTHPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModLTSPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModLTSPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModTDPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModTDPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModTOPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModTOPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModTUTPlayerController'.default.bBangModParryBox = bEnableBangMod;
	class'BangModTUTPlayerController'.default.bSkeletalParry = bEnableSkeletal;
}

simulated function ApplyParryBoxSettingsToCurrentPawn()
{
	local AOCPawn CurrentPawn;
	local vector ParryBoxTranslation;

	CurrentPawn = AOCPawn(Pawn);
	if (CurrentPawn == none || CurrentPawn.ParryComponent == none || CurrentPawn.PawnFamily == none)
	{
		return;
	}

	if (!class'BangModAOCDuelPlayerController'.default.bBangModParryBox)
	{
		CurrentPawn.ParryComponent.SetScale3D(vect(0.1, 0.17, 0.35));
		CurrentPawn.ParryComponent.SetTranslation(vect(30, 0, -30));
		return;
	}

	if (class'BangModAOCDuelPlayerController'.default.bSkeletalParry)
	{
		CurrentPawn.ParryComponent.SetScale3D(vect(0.18, 0.17, 0.35));
		CurrentPawn.ParryComponent.SetTranslation(vect(10, 5, -28));
		return;
	}

	ParryBoxTranslation = CurrentPawn.PawnFamily.ParryBoxTranslation;
	if (AOCWeaponAttachment(CurrentPawn.CurrentWeaponAttachment) != none)
	{
		ParryBoxTranslation += AOCWeaponAttachment(CurrentPawn.CurrentWeaponAttachment).ParryBoxTranslation;
	}

	CurrentPawn.ParryComponent.SetScale3D(CurrentPawn.PawnFamily.ParryBoxScale);
	CurrentPawn.ParryComponent.SetTranslation(ParryBoxTranslation);
}

reliable client function ClientSyncParryBoxSettings(bool bEnableBangMod, bool bEnableSkeletal)
{
	bBangModParryBox = bEnableBangMod;
	bSkeletalParry = bEnableSkeletal;
	SetAllParryBoxClassDefaults(bEnableBangMod, bEnableSkeletal);
	ApplyParryBoxSettingsToCurrentPawn();
}

simulated function SetAllCollisionRadiusClassDefaults(float Radius)
{
	class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModCDWDuelPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModCTFPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModFFAPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModKOTHPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModLTSPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModTDPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModTOPlayerController'.default.fBangModCollisionRadius = Radius;
	class'BangModTUTPlayerController'.default.fBangModCollisionRadius = Radius;
}

simulated function ApplyCollisionRadiusToCurrentPawn()
{
	local BangModAOCDuelPawn BMP;

	BMP = BangModAOCDuelPawn(Pawn);
	if (BMP == none || BMP.OuterCylinderComp == none)
		return;

	BMP.OuterCylinderComp.SetCylinderSize(class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius, 65.0);
}

reliable client function ClientSyncCollisionRadius(float Radius)
{
	fBangModCollisionRadius = Radius;
	SetAllCollisionRadiusClassDefaults(Radius);
	ApplyCollisionRadiusToCurrentPawn();
}

// Ensure BangMod uses its customization class everywhere
simulated event PostBeginPlay()
{
	super.PostBeginPlay();
	if (CustomizationClass != class'BangModCustomization')
	{
		CustomizationClass = class'BangModCustomization';
	}

	// BANGMOD: follow players in first person by default; Space toggles back to
	// the vanilla orbit follow. Set here rather than in state Spectating.BeginState
	// so the choice sticks for the whole session instead of resetting every time
	// the player re-enters spectate.
	bBangModFPSpectate = true;

	// Sweep remote talkers into Steam's voice layer. Client-only; the guard inside the
	// sweep handles Player not being set yet at this point.
	if (WorldInfo.NetMode != NM_DedicatedServer && !bBangModVoiceSweepArmed)
	{
		bBangModVoiceSweepArmed = true;
		SetTimer(5.0f, true, 'BangModVoiceSweepTick');
	}
}

/*
simulated function bool CanBastardSwordSprintAttack(AOCPawn AOCP)
{
	if (AOCP == none || AOCP.Weapon == none)
	{
		return false;
	}

	return AOCP.Weapon.Class == class'BangModWeapon_BastardSword'
		&& AOCP.bIsSprintMaxSpeed;
}
*/

// Allow sprint attack for the bastard sword without enabling it for the rest of Man at Arms.
exec function StartFire(optional byte FireModeNum)
{
	local AOCPawn AOCP;
	local bool bCanUseSprintAttack;

	AOCP = AOCPawn(Pawn);

	if (WorldInfo.Pauser == PlayerReplicationInfo)
	{
		SetPause(false);
		return;
	}

	if (AOCP != none)
	{
		bCanUseSprintAttack = AOCP.StateVariables.bIsSprinting
			&& !AOCP.StateVariables.bIsManualJumpDodge
			&& FireModeNum == Attack_Sprint
			&& !AOCP.StateVariables.bIsAttacking
			&& AOCP.StateVariables.bCanSprintAttack
			&& !ScriptBlockedInputs[EINBLOCK_AttackSprint]
			// && ((AOCP.bIsSprintMaxSpeed && AOCP.PawnFamily.bCanSprintAttack) || CanBastardSwordSprintAttack(AOCP));
			&& AOCP.bIsSprintMaxSpeed
			&& AOCP.PawnFamily.bCanSprintAttack;

		if (bCanUseSprintAttack)
		{
			if (!AOCP.HasEnoughStamina(20))
			{
				return;
			}
		}
		else
		{
			if (FireModeNum == Attack_Sprint)
			{
				return;
			}
		}

		if (FireModeNum == Attack_Parry && ScriptBlockedInputs[EINBLOCK_Block]
		  || FireModeNum == Attack_Slash && ScriptBlockedInputs[EINBLOCK_AttackSlash]
		  || FireModeNum == Attack_Stab && ScriptBlockedInputs[EINBLOCK_AttackStab]
		  || FireModeNum == Attack_Overhead && ScriptBlockedInputs[EINBLOCK_AttackOverhead]
		  || FireModeNum == Attack_Shove && ScriptBlockedInputs[EINBLOCK_AttackShove])
		{
			return;
		}

		if (AOCP.StateVariables.bCanParry && FireModeNum == Attack_Parry)
		{
			LastAttack = Attack_Parry;
			LastFireTime = WorldInfo.TimeSeconds;
			AOCP.StartFire(Attack_Parry);
			return;
		}

		if (FireModeNum == Attack_Shove && !AOCP.HasEnoughStamina(AOCP.PawnFamily.iKickcost))
		{
			AOCP.PlayLowStaminaGrunt();
			return;
		}

		if (AOCP.DodgeSM.bQueueDodgeAttack)
		{
			LastAttack = EAttack(FireModeNum);
			LastFireTime = WorldInfo.TimeSeconds;
			AOCP.DodgeSM.QueueAttack(FireModeNum);
			return;
		}

		if (!bCinematicMode && AOCP.StateVariables.bCanAttack)
		{
			LastAttack = EAttack(FireModeNum);
			LastFireTime = WorldInfo.TimeSeconds;
			AOCP.StartFire(FireModeNum);
		}

		return;
	}

	super.StartFire(FireModeNum);
}

// Override ProcessViewRotation to remove turn cap during parry counters
function ProcessViewRotation( float DeltaTime, out Rotator out_ViewRotation, Rotator DeltaRot )
{
	local float MaxTurnSpeed;
	local float MaxVertTurnSpeed;
	local bool bInAttackFlow;
	local bool bSavedAttacking;
	local float AttackH, AttackV;

	if( PreventTurning )
        return;
	if( PlayerCamera != None )
	{
		PlayerCamera.ProcessViewRotation( DeltaTime, out_ViewRotation, DeltaRot );
	}
	
	if(ScriptBlockedInputs[EINBLOCK_Rotate])
	{
		DeltaRot.Yaw = 0;
		DeltaRot.Pitch = 0;
		DeltaRot.Roll = 0;	
	}
	else if ( AOCPawn(Pawn) != None )
	{	
		// BANGMOD turncap desync fix. StateVariables is a *replicated* struct, so on a dedicated
		// server the server's snapshot of bIsAttacking periodically clobbers the owning client's
		// locally-predicted value. During rapid combos that bool can read false for a frame or two
		// between chained attacks; on those frames the gate below skipped the yaw clamp entirely
		// and an uncapped mouse delta was applied and then sent to (and trusted by) the server ->
		// the "turncap comes unbound / spin" desync. The weapon's simulated state
		// (Windup/Release/Transition) is driven by the client's own animation timers and does NOT
		// suffer that clobber, so use it as a stable fallback to keep the cap bound for the whole
		// combo. Melee only (ranged draw/reload has its own handling below).
		bInAttackFlow = Pawn.Weapon != none && AOCMeleeWeapon(Pawn.Weapon) != none
			&& (AOCWeapon(Pawn.Weapon).IsInState('Windup')
				|| AOCWeapon(Pawn.Weapon).IsInState('Release')
				|| AOCWeapon(Pawn.Weapon).IsInState('Transition'));

		if ( (AOCPawn(Pawn).StateVariables.bIsAttacking || bInAttackFlow) && LimitTurnSpeed  && Pawn.Weapon != none && AOCWeapon(Pawn.Weapon) != none)
		{
			MaxTurnSpeed = AOCWeapon(Pawn.Weapon).GetHorizontalRotateSpeed();
			MaxVertTurnSpeed = AOCWeapon(Pawn.Weapon).GetVerticalRotateSpeed();

			// If the replicated bool flickered false mid-combo, GetHorizontalRotateSpeed() returns
			// the *free-look* speed (its !bIsAttacking branch).  Call GetHorizontalRotateSpeed /
			// GetVerticalRotateSpeed again with a temporary bIsAttacking=true so per-firemode
			// overrides in subclasses are still respected during the flicker.  The FMax() against
			// the raw vars keeps a safe floor in case the override returns 0.
			if (bInAttackFlow && !AOCPawn(Pawn).StateVariables.bIsAttacking)
			{
				bSavedAttacking = AOCPawn(Pawn).StateVariables.bIsAttacking;
				AOCPawn(Pawn).StateVariables.bIsAttacking = true;
				AttackH = AOCWeapon(Pawn.Weapon).GetHorizontalRotateSpeed();
				AttackV = AOCWeapon(Pawn.Weapon).GetVerticalRotateSpeed();
				AOCPawn(Pawn).StateVariables.bIsAttacking = bSavedAttacking;

				if (AOCWeapon(Pawn.Weapon).CurrentFireMode == Attack_Sprint)
				{
					MaxTurnSpeed    = FMax(AttackH, AOCWeapon(Pawn.Weapon).SprintAttackHorizRotateSpeed);
					MaxVertTurnSpeed = FMax(AttackV, AOCWeapon(Pawn.Weapon).SprintAttackVerticalRotateSpeed);
				}
				else
				{
					MaxTurnSpeed    = FMax(AttackH, AOCWeapon(Pawn.Weapon).AttackHorizRotateSpeed);
					MaxVertTurnSpeed = FMax(AttackV, AOCWeapon(Pawn.Weapon).VerticalRotateSpeed);
				}
			}
			
			// BANGMOD: Loosen turn cap during parry animation - use Holy Water Sprinkler esque speeds
			if (AOCPawn(Pawn).StateVariables.bIsParrying)
			{
				MaxTurnSpeed = 75000.0;
				MaxVertTurnSpeed = 75000.0;
			}
			else
			{
				if ( AOCPawn(Pawn).StateVariables.bIsSprinting )
					MaxTurnSpeed = FMin(MaxTurnSpeed, MaxSprintTurnSpeed);
				
				if ( AOCPawn(Pawn).Weapon.IsInState('Reload') && AOCWeapon_Crossbow(AOCPawn(Pawn).Weapon) != none || AOCWeapon_PaviseShield(AOCPawn(Pawn).Weapon) != none)
				{
					MaxTurnSpeed = 0.0f;
					MaxVertTurnSpeed = 0.0f;
				}
			}
			
			if( AOCWeapon(Pawn.Weapon).IsInState( 'Windup' ) || AOCWeapon(Pawn.Weapon).IsInState( 'Release' ) || AOCWeapon(Pawn.Weapon).IsInState( 'Transition' ) || ( AOCPawn(Pawn).Weapon.IsInState('Reload') && AOCWeapon_Crossbow(AOCPawn(Pawn).Weapon) != none )
				|| (AOCPawn(Pawn).StateVariables.bIsAttacking && AOCPawn(Pawn).Weapon.CurrentFireMode == Attack_Sprint)
				|| AOCMeleeWeapon(Pawn.Weapon).bParryHitCounter)
			{
				if ( DeltaRot.Pitch >= 0 )
					DeltaRot.Pitch = FMin( DeltaRot.Pitch, MaxVertTurnSpeed * DeltaTime );
				else
					DeltaRot.Pitch = FMax( DeltaRot.Pitch, -MaxVertTurnSpeed * DeltaTime );
			}

			if ( DeltaRot.Yaw >= 0 )
				DeltaRot.Yaw = FMin( DeltaRot.Yaw, MaxTurnSpeed * DeltaTime);
			else
				DeltaRot.Yaw = FMax( DeltaRot.Yaw, -MaxTurnSpeed * DeltaTime);

			out_ViewRotation	+= DeltaRot;
			out_ViewRotation	 = LimitViewRotation(out_ViewRotation, -14000, 16383 );
		}
		else if(AOCWeapon_PaviseShield(AOCPawn(Pawn).Weapon) != none || AOCPawn(Pawn).PawnState == ESTATE_Execution)
		{
			if(AOCWeapon_PaviseShield(AOCPawn(Pawn).Weapon) != none)
			{
				out_ViewRotation.Pitch = 0;
			}
			
			DeltaRot.Yaw = 0;
			DeltaRot.Pitch = 0;
			DeltaRot.Roll = 0;
		}
		else
		{
			AOCPawn(Pawn).ProcessViewRotation( DeltaTime, out_ViewRotation, DeltaRot );
		}
		LastDeltaRot = DeltaRot;
	}
	else
	{
		out_ViewRotation += DeltaRot;
	}
}

// Override to prevent players from enabling ragdolls via console commands
exec function SetRagdollLimit(int NewLimit)
{
	// Always force to 0 regardless of what player requests
	MaxRagdolls = 0;
	default.MaxRagdolls = 0;
	
	// Clean up any existing ragdolls
	if (RagdolledPawns.Length > 0)
	{
		RemoveRagdolls(RagdolledPawns.Length);
	}
}

// Override to prevent ragdolls from being added in the first place
function AddRagdolledPawn(AOCPawn RagdolledPawn)
{
	// Immediately remove the ragdoll - don't add it to the list
	if (RagdolledPawn != none)
	{
		RagdolledPawn.LifeSpan = 0.1f;
	}
}

// Override Possess to enforce ragdoll limit and show optimization tip on first spawn
event Possess(Pawn inPawn, bool bVehicleTransition)
{
	super.Possess(inPawn, bVehicleTransition);

	// BANGMOD: Re-seed the client-clock offset carried from this player's previous pawn so the
	// hit-trade timestamp system starts warm instead of cold (pure ping reconstruction) for the
	// first hit or two after respawn. Offset is captured in PawnDied below. Server-only.
	if (Role == ROLE_Authority && bPersistedClockOffsetInit && BangModPawn(inPawn) != none)
		BangModPawn(inPawn).SeedClockOffset(fPersistedClientClockOffset);
	
	// Force ragdolls disabled on every spawn (catches players with read-only configs)
	ConsoleCommand("SetRagdollLimit 0");

	// Parry box settings live on the server class default and are read on the client when
	// pawns/attachments size the local debug box. Sync them on every possess so respawns and
	// late joins don't keep stale client-side defaults.
	// if (Role == ROLE_Authority)
	// {
	// 	ClientSyncParryBoxSettings(class'BangModAOCDuelPlayerController'.default.bBangModParryBox,
	// 		class'BangModAOCDuelPlayerController'.default.bSkeletalParry);
	// 	ClientSyncCollisionRadius(class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius);
	// }
	
	// Show optimization tip once when player first spawns
	if (!bShownOptimizationTip && Role == ROLE_Authority)
	{
		bShownOptimizationTip = true;
		SetTimer(2.0f, false, 'ShowOptimizationTip');
	}
}

// BANGMOD: Capture the dying pawn's accumulated client-clock offset so the next pawn can start
// warm (re-seeded in Possess). Runs before super so the pawn is still valid. Server-only.
function PawnDied(Pawn P)
{
	if (Role == ROLE_Authority && BangModPawn(P) != none && BangModPawn(P).bClientClockOffsetInit)
	{
		fPersistedClientClockOffset = BangModPawn(P).fClientClockOffset;
		bPersistedClockOffsetInit = true;
	}

	super.PawnDied(P);
}

// Send optimization tip as a server message that appears in chat
function ShowOptimizationTip()
{
	ReceiveChatMessage("=== Welcome to SlumpMod ===", EFAC_ALL, false, true, "#00FF00");
	ReceiveChatMessage("Join our discord at https://discord.gg/G4Zsm62z5J", EFAC_ALL, false, true, "#FFAA00");
	ReceiveChatMessage("disableScreenShake True - in console", EFAC_ALL, false, true, "#ffffff");
}

reliable server function bool IsAdmin() {
	return WorldInfo.Game.AccessControl.IsAdmin(self) || WorldInfo.NetMode == NM_Standalone;
}

reliable server function S_AdminBroadcastMessage(string Message, optional bool bShowName=true) {
	local AOCPlayerController PC;
	foreach WorldInfo.AllControllers(class'AOCPlayerController', PC) {
		if (bShowName)
			PC.ReceiveChatMessage(AOCPRI(PlayerReplicationInfo).GetHumanReadableName()$":"@Message, EFAC_ALL, false, false, ,false);
		else
			PC.ReceiveChatMessage(Message, EFAC_ALL, false, false, ,false);
	}
}

// Admin-only pause/unpause. Overrides the engine SetPause so a non-admin can
// neither pause (e.g. typing "pause" in the console) nor unpause the game.
function bool SetPause(bool bPause, optional delegate<CanUnpause> CanUnpauseDelegate=CanUnpause) {
	local bool bResult;
	if (bPause) {
		if (!IsAdmin()) {
			ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
			return false;
		}
		bFire = 0;
		bResult = WorldInfo.Game.SetPause(self, CanUnpauseDelegate);
		if (bResult) {
			PauseRumbleForAllPlayers();
			bIsPaused = true;
		}
	} else if (IsAdmin() && bIsPaused) {
		// Route through countdown instead of immediate unpause
		S_StartUnpauseCountdown();
	}
	return bResult;
}

// Explicit admin command to start the unpause countdown.
exec function UnPause() {
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_StartUnpauseCountdown();
}

reliable server function S_StartUnpauseCountdown() {
	if (!IsAdmin())
		return;
	if (!bIsPaused) {
		ClientDisplayConsoleMessage("The game is not currently paused.");
		return;
	}
	UnpauseCountdownTime = Default.UnpauseCountdownTime;
	S_AdminBroadcastMessage("Unpausing in...", false);
	WorldInfo.Game.ClearPause();
	PauseRumbleForAllPlayers(false);
	bIsPaused = false;
	UnpauseCountdownTick();
	SetTimer(1.0f, true, 'UnpauseCountdownTick');
}

function UnpauseCountdownTick() {
	if (UnpauseCountdownTime == 0) {
		S_AdminBroadcastMessage("GO!", false);
		ClearTimer('UnpauseCountdownTick');
	} else {
		S_AdminBroadcastMessage("    "$UnpauseCountdownTime$"...", false);
		UnpauseCountdownTime--;
	}
}

exec function AdminBroadcastMessage(String Message) {
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminBroadcastMessage(Message);
}

exec function AdminCoinFlip() {
	local int Coin;
	local string Result;
	local AOCPlayerController PC;

	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}

	Coin = Rand(2);
	if (Coin == 0)
		Result = "Heads";
	else
		Result = "Tails";

	foreach WorldInfo.AllControllers(class'AOCPlayerController', PC) {
		PC.ReceiveChatMessage(AOCPRI(PlayerReplicationInfo).GetHumanReadableName()@"flipped a coin:"@Result, EFAC_ALL, false, true, "#00FF00");
	}
}

