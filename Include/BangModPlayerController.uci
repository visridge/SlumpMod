		StartFire(1);
}

reliable server function ServerPerformFeint()
{
	local float TimeSinceLastFeint;
	
	// Block feint if already in Active/Feint state
	if (Pawn.Weapon.IsInState('Active') || Pawn.Weapon.IsInState('Feint'))
		return;
	
	// Custom: Prevent feint spam during Release/Transition/early riposte to fix visual desync bug
	// Block feint during Release state (attack active frames)
	if (Pawn.Weapon.IsInState('Release'))
		return;
		
	// Prevent feint spamming with 200ms cooldown between attempts
	TimeSinceLastFeint = WorldInfo.TimeSeconds - fLastFeintTime;
	if (TimeSinceLastFeint < 0.2)
		return;
		
	fLastFeintTime = WorldInfo.TimeSeconds;

	AOCPawn(Pawn).OnActionInitiated(EACT_Feint);
	AOCWeapon(Pawn.Weapon).DoFeintAttack();

	`{GAMEMODE}PRI(PlayerReplicationInfo).Feints += 1;
}

