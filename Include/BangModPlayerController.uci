	*/
}

/* ************************************************************************
 * FIRST-PERSON SPECTATOR -- post-spawn camera correction
 *
 * PlayerController.ClientRestart (:4728) calls SetViewTarget(Pawn) while still inside
 * state Spectating, and only then EnterStartState(). Two consequences:
 *
 * 1. AOCPawn.BecomeViewTarget takes its spectator branch and never calls super, so
 *    UTPawn's possession setup (arm attach, mesh visibility, eye height) is skipped
 *    for our own pawn.
 * 2. GetPlayerViewPoint reads PlayerCamera and ignores Pawn/ViewTarget whenever one
 *    exists. AOC only destroys it in state Spectating.GetPlayerViewPoint, so leaving
 *    spectate with one alive strands the view on a fixed map spot while the pawn plays
 *    underneath. ResetCameraMode cannot help -- SetCameraMode is a no-op when
 *    PlayerCamera is None.
 *
 * So the camera is re-asserted one tick after ClientRestart, once the state
 * transition has actually completed.
 **************************************************************************/

/** One-line camera dump to the log. Use with the FPSpectateDebug exec when chasing camera bugs. */
simulated function BangModLogCameraState(string Tag)
{
	LogAlwaysInternal("[BangModFPSpec]" @ Tag
		@ "State=" $ GetStateName()
		@ "Pawn=" $ Pawn
		@ "ViewTarget=" $ ViewTarget
		@ "PlayerCamera=" $ PlayerCamera
		@ "bBehindView=" $ bBehindView
		@ "bFreeCamera=" $ bFreeCamera
		@ "PCLoc=" $ Location);
}

/** Fired on a short timer from ClientRestart, after EnterStartState has run. */
simulated function BangModFixCameraAfterSpawn()
{
	local AOCPawn MyPawn;

	if (!IsLocalPlayerController())
		return;

	BangModLogCameraState("post-spawn");

	if (Pawn == none || IsInState('Spectating') || IsInState('SpecialSpectating'))
		return;

	// (2) above -- a surviving PlayerCamera outranks Pawn and ViewTarget entirely.
	if (PlayerCamera != none)
	{
		PlayerCamera.Destroy();
		PlayerCamera = none;
	}

	// The spectator camera drove this and nothing on the spawn path clears it.
	bFreeCamera = false;

	// (1) above -- force the view target transition to happen again, now that we are
	// out of Spectating, so AOCPawn.BecomeViewTarget takes its normal branch and
	// chains into UTPawn's possession-view setup.
	MyPawn = AOCPawn(Pawn);
	if (MyPawn != none)
	{
		MyPawn.bIsBeingFPObserved = false;
		MyPawn.CurrentObserver = none;
	}

	SetViewTarget(none);
	SetViewTarget(Pawn);

	// state Spectating.GetPlayerViewPoint has been SetLocation()-ing this controller
	// onto the spectator camera position every frame.
	SetLocation(Pawn.Location);

	BangModLogCameraState("post-spawn-corrected");
}

reliable client function ClientRestart(Pawn NewPawn)
{
	super.ClientRestart(NewPawn);

	if (NewPawn != none && IsLocalPlayerController())
		SetTimer(0.05f, false, 'BangModFixCameraAfterSpawn');
}

/* ************************************************************************
 * FIRST-PERSON SPECTATOR
 *
 * Vanilla already has a complete FP-observer path -- bIsBeingFPObserved gates the 1P
 * mesh, camera socket, overlay weapon and HUD push -- but nothing is wired to it:
 * state Spectating.ViewAPlayer force-calls SetBehindView(true) and BehindView() is an
 * empty stub.
 *
 * BangMod re-declares state Spectating to route target changes through it. Once
 * bIsBeingFPObserved is actually set, the hand-rolled workarounds are unnecessary:
 * AOCPlayerCamera.UpdateCamera takes its FP branch and zeroes CameraRotation.Roll
 * (the sprint-lean tilt fix), and SetThirdPersonCamera(false) shows the 1P mesh so
 * there is no head to hide.
 *
 * First person by default; Space toggles the vanilla orbit follow, right click
 * still detaches to free camera.
 ************************************************************************** */

/**
 * Why first-person observe cannot be applied to this pawn, or "" when it can. One source
 * of truth so the diagnostic and the decision cannot drift. Each item is something
 * BecomeFirstPersonObserved or SetThirdPersonCamera dereferences unguarded, and a pawn can
 * be network-relevant before it has them all.
 *
 * NOT checked: HelmetEmitter. AOCPawn only creates it for helmets with a particle system,
 * so it is none on most pawns, and SetThirdPersonCamera dereferences it unguarded anyway --
 * requiring it refused first person for nearly everyone and bought no safety.
 */
simulated function string BangModFPObserveBlocker(AOCPawn P)
{
	if (P == none)
		return "pawn is none";
	if (P.OwnerMesh == none)
		return "OwnerMesh is none (the 1P mesh could not be rebuilt)";
	if (P.OwnerMesh.SkeletalMesh == none)
		return "OwnerMesh has no SkeletalMesh";
	if (P.CharacterAssetStore == none)
		return "CharacterAssetStore is none";
	if (P.HelmetMeshComp == none)
		return "HelmetMeshComp is none";
	if (P.ShieldMesh == none)
		return "ShieldMesh is none";
	if (P.OverlayShieldMesh == none)
		return "OverlayShieldMesh is none";
	if (AOCWeaponAttachment(P.CurrentWeaponAttachment) == none)
		return "CurrentWeaponAttachment is not an AOCWeaponAttachment";
	if (P.CurrentWeaponAttachment.Mesh == none)
		return "the weapon attachment has no Mesh";

	return "";
}

simulated function bool BangModCanFPObserve(AOCPawn P)
{
	return BangModFPObserveBlocker(P) == "";
}

/**
 * Puts the observed pawn into real first-person-observer state.
 *
 * Ordering trap: state Spectating.SetBehindView(false) reaches
 * BecomeFirstPersonObserved -> BecomeViewTarget -> SetThirdPersonCamera(!bIsBeingFPObserved),
 * and the flag is still false at that point -- so it re-runs as SetThirdPersonCamera(TRUE)
 * before the flag is set. Vanilla's own order leaves the pawn flagged for a 1P camera but
 * visually in 3P, which is the "inside the head" view. The meshes are put back afterwards.
 */
simulated function bool BangModApplyFPObserve(AOCPawn P)
{
	local string Blocker;

	if (P == none || !IsLocalPlayerController())
		return false;

	Blocker = BangModFPObserveBlocker(P);
	if (Blocker != "")
	{
		// Once per pawn: silence is what made this hard to diagnose the first time.
		if (BangModFPBlockLoggedPawn != P)
		{
			BangModFPBlockLoggedPawn = P;
			LogAlwaysInternal("[BangModFPSpec] first person refused for"@P$":"@Blocker);
		}
		return false;
	}

	if (BangModFPObservedPawn != none && BangModFPObservedPawn != P)
		BangModClearFPObserve();

	SetBehindView(false);
	P.SetThirdPersonCamera(false);

	BangModFPObservedPawn = P;
	return true;
}

/**
 * Undoes BangModApplyFPObserve on whichever pawn we last applied it to.
 * AOCPawn.EndViewTarget() clears bIsBeingFPObserved / CurrentObserver but does
 * NOT restore mesh visibility, so a pawn we stop following would keep its 1P
 * mesh unhidden and its 3P body flagged owner-no-see.
 */
simulated function BangModClearFPObserve()
{
	local AOCPawn P;

	if (BangModFPObservedPawn == none)
		return;

	P = BangModFPObservedPawn;
	BangModFPObservedPawn = none;

	P.bIsBeingFPObserved = false;
	if (P.CurrentObserver == self)
		P.CurrentObserver = none;

	if (BangModCanFPObserve(P))
		P.SetThirdPersonCamera(true);
}

/**
 * Hand the camera back to the vanilla spectator behaviour.
 *
 * AOCPlayerController.state Spectating.SetBehindView dereferences
 * AOCGRI(WorldInfo.GRI) with no none-check, and this is reachable the instant we
 * enter spectate -- before the GRI has replicated to a joining client. Fall back to
 * setting the flags directly in that window; PlayerTick re-establishes properly
 * once a real target arrives.
 */
simulated function BangModRestoreVanillaCamera()
{
	if (WorldInfo.GRI != none)
	{
		SetBehindView(true);
	}
	else
	{
		bBehindView = true;
		bFreeCamera = true;
	}
}

/**
 * May we look at this player? Mirrors AOCGame.CanSpectate (:5104) rather than inventing a
 * second rule: real spectators see everybody, players see only their own team.
 *
 * The difference is WHERE. CanSpectate is server-side and only gates
 * GetNextViewablePlayer; this is simulated off replicated PRI data, so the client can apply
 * the same rule to what that gate does not cover -- FP observation and the life bars.
 *
 * Exists because players reported cycling onto ENEMY pawns in first person, leaking flanks,
 * health and the VIP marker. The path by which the server hands out an enemy PRI was never
 * found, so this does not claim to fix a proven cause -- it enforces the rule everywhere we
 * control and counts refusals, so FPSpectateDebug can say whether the server gate leaks.
 */
simulated function bool BangModMayView(PlayerReplicationInfo TargetPRI)
{
	local AOCPRI MyPRI;

	if (TargetPRI == none || PlayerReplicationInfo == none)
		return false;

	// Dedicated spectators may watch anybody.
	if (PlayerReplicationInfo.bOnlySpectator)
		return true;

	MyPRI = AOCPRI(PlayerReplicationInfo);
	if (MyPRI != none && MyPRI.bIsVoluntarySpectator)
		return true;

	// On a team: own team only. A player with no team yet gets nothing rather than
	// everything -- failing closed is the whole point here.
	return (PlayerReplicationInfo.Team != none && TargetPRI.Team == PlayerReplicationInfo.Team);
}

/** Records a refusal so FPSpectateDebug can report whether this ever actually fires. */
simulated function BangModNoteViewBlock(name Where)
{
	iBangModViewBlocks++;
	nBangModViewBlockWhere = Where;
}

/** Applies whichever perspective the spectator currently wants to the current view target. */
simulated function BangModApplySpectatorPerspective()
{
	local AOCPawn P;

	if (!IsLocalPlayerController())
		return;

	P = AOCPawn(ViewTarget);

	// Never put a player into first person on somebody they are not allowed to watch.
	// First person is the worst case of the leak: it hands over the exact view, the
	// health and stamina bars, and any HUD marker that pawn's team can see.
	if (P != none && !BangModMayView(P.PlayerReplicationInfo))
	{
		BangModNoteViewBlock('Perspective');
		P = none;
	}

	if (P == none || P.Health <= 0)
	{
		BangModClearFPObserve();
		BangModPerspectivePawn = none;

		// SetBehindView(false) cleared bFreeCamera (UTPlayerController.SetBehindView).
		// Hand it back, or the free camera can neither move nor look around --
		// state Spectating.PlayerMove early-outs on !bFreeCamera before UpdateRotation.
		BangModRestoreVanillaCamera();
		return;
	}

	BangModPerspectivePawn = P;

	if (bBangModFPSpectate && BangModApplyFPObserve(P))
		return;

	// Either the spectator asked for the orbit follow, or this pawn cannot be
	// first-person observed (most often its 1P mesh could not be rebuilt).
	//
	// Falling through to an explicit SetBehindView(true) matters: vanilla's
	// ViewAPlayer called SetBehindView(true) on EVERY target change and our
	// override deliberately does not, so if neither branch here establishes camera
	// state the controller is left running on whatever bBehindView / bFreeCamera
	// happened to be left over -- which is how you end up with a camera that is
	// neither following anybody nor accepting input.
	BangModClearFPObserve();
	BangModRestoreVanillaCamera(); // state Spectating.SetBehindView re-enables bFreeCamera
}

/**
 * Keep the health/stamina bars on screen and current for whoever we are looking at -- our
 * own pawn, or the followed player while spectating.
 *
 * Vanilla has too many holes to patch individually: bars are shown only from
 * ShowHUDElements on possession, DisplayCompleteHUD silently no-ops before the GFx HUD is
 * built and nobody retries, nothing shows them for a spectator, and PlayerTick only pushes
 * on change so a missed initial push leaves them stale.
 *
 * So assert the desired state every tick instead. Throttled to a visibility re-assert twice
 * a second plus a value push only on change. Never HIDES -- vanilla owns that.
 */
simulated function BangModEnforceLifeBars()
{
	local AOCBaseHUD H;
	local AOCPawn Subject;

	if (!IsLocalPlayerController())
		return;

	H = AOCBaseHUD(myHUD);

	// CheckCanUseHUD() is false until the GFx HUD exists. Returning without recording
	// anything means we simply try again next tick.
	if (H == none || !H.CheckCanUseHUD())
		return;

	// Our own pawn wins; otherwise show whoever we are spectating.
	Subject = AOCPawn(Pawn);
	if (Subject == none)
	{
		Subject = AOCPawn(ViewTarget);

		// Only for somebody we are allowed to watch. This ran from the GLOBAL tick with
		// no team test, so it pushed health and stamina for whatever the view target
		// happened to be -- including an enemy on the death camera, in any state, not
		// just while spectating. That was this function's bug, not vanilla's.
		if (Subject != none && !BangModMayView(Subject.PlayerReplicationInfo))
		{
			BangModNoteViewBlock('LifeBars');
			Subject = none;
		}
	}

	if (Subject == none || Subject.Health <= 0)
	{
		BangModLifeBarPawn = none;
		return;
	}

	// Re-assert visibility whenever the subject changes, and twice a second after
	// that, so anything which hides the bars behind our back is corrected quickly.
	if (Subject != BangModLifeBarPawn || WorldInfo.TimeSeconds >= fBangModNextLifeBarAssert)
	{
		BangModLifeBarPawn = Subject;
		fBangModNextLifeBarAssert = WorldInfo.TimeSeconds + 0.5f;

		H.DisplayCompleteHUD();

		// Force a value push on the next two tests regardless of the change filter.
		iBangModLastHealthShown = -1;
		fBangModLastStaminaShown = -1.f;
	}

	if (Subject.Health != iBangModLastHealthShown)
	{
		iBangModLastHealthShown = Subject.Health;
		H.SetHealthValues(Subject.Health, Subject.HealthMax);
	}

	if (Subject.Stamina != fBangModLastStaminaShown)
	{
		fBangModLastStaminaShown = Subject.Stamina;
		H.SetStaminaValues(Subject.Stamina, Subject.MaxStamina);
	}
}

/**
 * Hold the spectator's field of view at the value they configured.
 *
 * There is no camera object in normal play -- AOCPlayerCamera extends Object, not Camera --
 * so the engine reads FOVAngle directly, and the only thing that re-establishes a custom FOV
 * is AOCPawn calling SetFOV on spawn (:9078). A spectator has no pawn, so anything that
 * knocks those fields around on the way into spectate is permanent.
 *
 * The write was never found. Every FOV assignment in the tree was ruled out; the one
 * candidate unfalsifiable from script is state Spectating.GetPlayerViewPoint passing
 * FOVAngle BY REFERENCE into CalcCamera, so any override writing out_FOV owns it (AOCPawn's
 * dying state does exactly that). So assert the value instead -- correct whichever it was.
 *
 * Gated on Pawn == none: weapon zoom drives DesiredFOV in live play and must not be fought.
 */
simulated function BangModEnforceSpectateFOV(name Where)
{
	if (!IsLocalPlayerController() || Pawn != none)
		return;

	// Never invent a value. MyFOV is the same globalconfig the FOV exec writes and the
	// pawn reads on spawn, so this holds spectate to exactly what live play uses.
	if (MyFOV < 60.0 || MyFOV > 165.0)
		return;

	if (DefaultFOV == MyFOV && DesiredFOV == MyFOV && FOVAngle == MyFOV)
		return;

	// Record what we caught, so FPSpectateDebug can finally name the culprit.
	if (FOVAngle != MyFOV)
		fBangModFOVCaught = FOVAngle;
	else if (DesiredFOV != MyFOV)
		fBangModFOVCaught = DesiredFOV;
	else
		fBangModFOVCaught = DefaultFOV;
	nBangModFOVCaughtWhere = Where;

	DefaultFOV = MyFOV;
	DesiredFOV = MyFOV;
	FOVAngle   = MyFOV;
}

/** Console toggle, in case somebody wants to default to the vanilla orbit follow. */
exec function FirstPersonSpectate(optional bool bEnable = true)
{
	bBangModFPSpectate = bEnable;
	if (IsInState('Spectating'))
		BangModApplySpectatorPerspective();
}

/**
 * Diagnostic for first-person spectate. Type "FPSpectateDebug" in the console
 * while following a player.
 *
 * The usual failure is "OwnerMesh: None" -- see BangModEnsureOwnerMesh in
 * BangModPawn.uci for why the 1P mesh gets stripped and how it is rebuilt.
 */
exec function FPSpectateDebug()
{
	local AOCPawn P;

	ClientDisplayConsoleMessage("---- BangMod camera / spectate state ----");
	ClientDisplayConsoleMessage("State:" @ GetStateName() @ "| NetMode:" @ int(WorldInfo.NetMode) @ "| LocalPC:" @ IsLocalPlayerController());
	ClientDisplayConsoleMessage("bBangModFPSpectate:" @ bBangModFPSpectate @ "| bBehindView:" @ bBehindView @ "| bFreeCamera:" @ bFreeCamera);
	ClientDisplayConsoleMessage("Pawn:" @ Pawn);
	ClientDisplayConsoleMessage("ViewTarget:" @ ViewTarget @ "| RealViewTarget:" @ RealViewTarget);

	// A non-none PlayerCamera outside a CameraActor view is a camera lock: the
	// engine reads the view straight off it and ignores Pawn/ViewTarget entirely.
	ClientDisplayConsoleMessage("PlayerCamera:" @ PlayerCamera @ " <-- should be None during normal play");
	ClientDisplayConsoleMessage("FOV: MyFOV=" $ MyFOV @ "Default=" $ DefaultFOV @ "Desired=" $ DesiredFOV @ "Angle=" $ FOVAngle);
	if (iBangModViewBlocks > 0)
		ClientDisplayConsoleMessage("Team lock: refused" @ iBangModViewBlocks @ "out-of-team view target(s), last in" @ nBangModViewBlockWhere);
	else
		ClientDisplayConsoleMessage("Team lock: no out-of-team view target has been refused.");

	if (nBangModFOVCaughtWhere != '')
		ClientDisplayConsoleMessage("FOV lock: last corrected a stray" @ fBangModFOVCaught @ "in" @ nBangModFOVCaughtWhere);
	else
		ClientDisplayConsoleMessage("FOV lock: has not had to correct anything yet.");

	ClientDisplayConsoleMessage("FPObservedPawn:" @ BangModFPObservedPawn @ "| PerspectivePawn:" @ BangModPerspectivePawn);

	if (Pawn != none && ViewTarget != Pawn)
		ClientDisplayConsoleMessage("!! ViewTarget is not our own Pawn while we have one -- that is the frozen-camera signature.");

	P = AOCPawn(ViewTarget);
	if (P == none)
	{
		ClientDisplayConsoleMessage("ViewTarget is not an AOCPawn.");
		ClientDisplayConsoleMessage("---------------------------------------");
		return;
	}

	ClientDisplayConsoleMessage("Health:" @ P.Health @ "| bIsBot:" @ P.bIsBot @ "| LocallyControlled:" @ P.IsLocallyControlled());
	ClientDisplayConsoleMessage("bIsBeingFPObserved:" @ P.bIsBeingFPObserved);
	ClientDisplayConsoleMessage("OwnerMesh (1P component):" @ P.OwnerMesh);
	ClientDisplayConsoleMessage("OwnerAimNode:" @ P.OwnerAimNode);
	ClientDisplayConsoleMessage("CharacterAssetStore:" @ P.CharacterAssetStore);

	if (P.CharacterAssetStore != none)
	{
		ClientDisplayConsoleMessage("  1P mesh asset:" @ P.CharacterAssetStore.OwnerMesh);
		ClientDisplayConsoleMessage("  CharacterInfo set:" @ (P.CharacterAssetStore.CharacterInfo != none));
	}

	ClientDisplayConsoleMessage("HelmetMeshComp:" @ P.HelmetMeshComp @ "| HelmetEmitter:" @ P.HelmetEmitter);
	ClientDisplayConsoleMessage("ShieldMesh:" @ P.ShieldMesh @ "| OverlayShieldMesh:" @ P.OverlayShieldMesh);
	ClientDisplayConsoleMessage("WeaponAttachment:" @ AOCWeaponAttachment(P.CurrentWeaponAttachment));
	if (BangModCanFPObserve(P))
		ClientDisplayConsoleMessage("=> CanFPObserve: TRUE");
	else
		ClientDisplayConsoleMessage("=> CanFPObserve: FALSE --" @ BangModFPObserveBlocker(P));
	ClientDisplayConsoleMessage("---------------------------------------");
}

state Spectating
{
	function BeginState(Name PreviousStateName)
	{
		super.BeginState(PreviousStateName);

		// super sets SetViewTarget(none), so nothing is observed yet.
		BangModFPObservedPawn = none;
		BangModHUDPawn = none;
		BangModPerspectivePawn = none;

		// Claim the field of view the moment we arrive, before the first frame renders.
		BangModEnforceSpectateFOV('BeginState');
	}

	function EndState(Name NextStateName)
	{
		BangModClearFPObserve();

		// Deliberately does NOT touch the HUD. An earlier version called
		// ClearHUDOnDeath() here and cost every player their bars, crosshair and ammo
		// count for a whole life: on spawn the server's Possess() fires
		// ShowHUDElements() -> DisplayCompleteHUD() BEFORE ClientRestart() reaches
		// EnterStartState(), so hiding here undid vanilla a moment after it showed them.
		// BangModEnforceLifeBars() now owns bar visibility; vanilla owns hiding on death.
		BangModLifeBarPawn = none;
		BangModHUDPawn = none;
		BangModPerspectivePawn = none;

		super.EndState(NextStateName);
	}

	/**
	 * Runs on the server (called from ServerViewNextPlayer / ServerViewPrevPlayer).
	 *
	 * Deliberately does NOT call super. Vanilla's version force-calls
	 * SetBehindView(true) here, and because the server has no LocalPlayer that
	 * turns into a ClientSetBehindView(true) RPC which drags the client back into
	 * third person on every single target change. The client decides its own
	 * perspective in ClientSetViewTarget below.
	 */
	function ViewAPlayer(int dir)
	{
		local PlayerReplicationInfo PRI;

		PRI = GetNextViewablePlayer(dir);
		if (PRI == None)
			return;

		// Belt and braces on top of GetNextViewablePlayer, which already consults
		// AOCGame.CanSpectate for every candidate. If that gate works this is dead code
		// and iBangModViewBlocks stays at zero; if it is leaking, this stops it here on
		// the server -- where it matters, since a client cannot be trusted to refuse a
		// view target it has already been given.
		if (!BangModMayView(PRI))
		{
			BangModNoteViewBlock('ViewAPlayer');
			return;
		}

		SetViewTarget(PRI);

		if (ViewTarget != none)
			SetReality(ViewTarget.RealityID);

		ClientSetViewTarget(ViewTarget);
	}

	/** The client-side hook for "the view target changed" -- this is where perspective is applied. */
	reliable client event ClientSetViewTarget( Actor A, optional ViewTargetTransitionParams TransitionParams )
	{
		// Restore the outgoing pawn before the native SetViewTarget inside super
		// fires EndViewTarget on it (EndViewTarget does not restore its meshes).
		if (BangModFPObservedPawn != none && BangModFPObservedPawn != A)
			BangModClearFPObserve();

		super.ClientSetViewTarget(A, TransitionParams);

		BangModApplySpectatorPerspective();

		BangModHUDPawn = AOCPawn(ViewTarget);
	}

	/**
	 * Left click / right click cycle the spectate target.
	 *
	 * Free for the taking: AOCPlayerController.state Spectating declares both of these
	 * as empty stubs (AOCPlayerController.uc:5030-5038), so the mouse buttons do
	 * nothing at all while spectating today. Engine's PlayerController.state Spectating
	 * did bind StartFire to ServerViewNextPlayer; AOC stubbed it out and never replaced
	 * it. Right click's vanilla meaning -- ResetCameraMode + ServerViewSelf -- was
	 * already lost to that stub, and free camera keeps its existing binding, so nothing
	 * reachable is being taken away here.
	 */
	exec function StartFire(optional byte FireModeNum)
	{
		SpectatorNext();
	}

	exec function StartAltFire(optional byte FireModeNum)
	{
		SpectatorPrevious();
	}

	/** Space. Toggles between first person and the vanilla orbit follow. */
	exec function SpectatorPerspective()
	{
		if (AOCPawn(ViewTarget) == none)
			return; // free camera / nobody followed -- nothing to toggle

		bBangModFPSpectate = !bBangModFPSpectate;
		BangModApplySpectatorPerspective();
	}

	/** Same key path, reached via UTPlayerController.BehindView bindings. */
	exec function BehindView()
	{
		SpectatorPerspective();
	}

	/** Camera angles only mean anything in the orbit follow. */
	exec function NextCameraAngle()
	{
		if (bBangModFPSpectate && AOCPawn(ViewTarget) != none)
			return;

		iThirdPersonAngle = 1;
	}

	/** Right click. */
	exec function SpectatorFreecam()
	{
		BangModClearFPObserve();
		super.SpectatorFreecam();

		// Restore bFreeCamera, which SetBehindView(false) zeroed on the way into
		// first person. Without this the free camera is frozen in place.
		SetBehindView(true);

		BangModHUDPawn = none;
		BangModPerspectivePawn = none;
	}

	/**
	 * The last thing to run before the engine reads GetFOVAngle() for this frame.
	 *
	 * Vanilla's version hands FOVAngle to ViewTarget.CalcCamera as an out parameter, so
	 * a view target is free to overwrite the spectator's field of view every single
	 * frame -- which a tick-time correction would lose to, since tick runs first.
	 * Re-asserting here closes that ordering hole; see BangModEnforceSpectateFOV.
	 */
	simulated event GetPlayerViewPoint( out vector POVLocation, out Rotator POVRotation )
	{
		super.GetPlayerViewPoint(POVLocation, POVRotation);
		BangModEnforceSpectateFOV('GetPlayerViewPoint');
	}

	event PlayerTick(float DeltaTime)
	{
		local AOCPawn P;

		super.PlayerTick(DeltaTime);

		// Covers whatever moves the value outside the render path.
		BangModEnforceSpectateFOV('PlayerTick');

		if (!IsLocalPlayerController())
			return;

		P = AOCPawn(ViewTarget);
		if (P != none && P.Health <= 0)
			P = none; // dead: let the vanilla death camera / auto-advance take over

		if (P == none)
		{
			if (BangModFPObservedPawn != none)
			{
				BangModClearFPObserve();
				BangModPerspectivePawn = none;
				BangModRestoreVanillaCamera();
			}
		}
		else if (BangModPerspectivePawn != P)
		{
			// New pawn (target switch, or the old one respawned as a new object).
			// Establish a definite camera state exactly once.
			BangModApplySpectatorPerspective();
		}
		else if (bBangModFPSpectate && !P.bIsBeingFPObserved)
		{
			// Keep retrying first person on the pawn we already settled on.
			if (P.OwnerMesh != none)
			{
				BangModApplyFPObserve(P);
			}
			else if (WorldInfo.TimeSeconds >= fBangModNextFPRetry)
			{
				// The 1P mesh is rebuilt by the pawn's BecomeViewTarget override, which
				// only fires on a view-target change. If its character assets had not
				// streamed in by then, nothing would ever try again -- so poke it. Rate
				// limited so a pawn that genuinely cannot be rebuilt costs us nothing.
				fBangModNextFPRetry = WorldInfo.TimeSeconds + 0.5f;
				P.BecomeViewTarget(self);
			}
		}

		// Keep the 1P mesh's aim offset fed.
		// AOCPawn.FaceRotation() is the only thing that copies AimNode -> OwnerAimNode,
		// and FaceRotation is only invoked for a locally controlled pawn
		// (PlayerController.UpdateRotation / ProcessMove). For a pawn we are merely
		// observing it never runs, which would leave the 1P mesh -- and therefore the
		// camera socket -- refusing to pitch with the observed player's aim.
		// Cheap enough to just re-copy every frame.
		if (P != none && P.bIsBeingFPObserved && P.OwnerAimNode != none && P.AimNode != none)
		{
			P.OwnerAimNode.Aim.X = P.AimNode.Aim.X;
			P.OwnerAimNode.Aim.Y = P.AimNode.Aim.Y;
		}

		BangModHUDPawn = P;
	}
}

/* ************************************************************************
 * PROXIMITY VOICE CHAT IMPLEMENTATION
 * BangMod adds working proximity voice chat functionality
 **************************************************************************/

// Push-to-talk command (bound to G key by default)
/**
 * Re-enable networked voice by restoring UTPlayerController's implementation.
 *
 * The engine's voice stack is intact -- verified in the shipped binary, which carries
 * FVoiceInterfaceSteamworks, UVoiceChannel, RegisterRemoteTalker, StartNetworkedVoice and
 * Steam's own ISteamUser voice API. There is no Speex because Steam owns the codec.
 *
 * Two lines of TB script disabled it: AOCGame.uc:1826 calls ClientStopNetworkedVoice() on
 * every join, and AOCPlayerController.uc:3700 is an empty ToggleSpeaking override where UT
 * does the real work. Keybinds and server settings survived, which is why it looks like an
 * engine-level removal from outside. Speech recognition is deliberately left out.
 *
 * VoiceInterface can legitimately be None -- type VoiceDebug rather than guessing.
 */
exec function ToggleSpeaking(bool bNowOn)
{
	local LocalPlayer LP;
	local OnlineVoiceInterface VI;

	LP = LocalPlayer(Player);
	if (LP == none)
		return;

	// PlayerController.VoiceInterface is only assigned in RegisterOnlineDelegates
	// (PlayerController.uc:2347). Fall back to the subsystem's copy so a missed
	// registration does not silently mean "no voice".
	VI = VoiceInterface;
	if (VI == none && OnlineSub != none)
		VI = OnlineSub.VoiceInterface;

	if (VI == none)
	{
		ClientDisplayConsoleMessage("Voice: no voice interface available (see VoiceDebug).");
		return;
	}

	if (bNowOn)
		VI.StartNetworkedVoice(LP.ControllerId);
	else
		VI.StopNetworkedVoice(LP.ControllerId);

	// The talking indicator lives HERE, not in GBA_ToggleSpeaking.
	//
	// GBA_ToggleSpeaking is an input ALIAS, not our exec:
	//     Bindings=(Name="GBA_ToggleSpeaking",
	//               Command="ToggleSpeaking true | OnRelease ToggleSpeaking false")
	// so the key expands straight to ToggleSpeaking(true/false) and the exec of that
	// name is never reached. That is why pressing to talk showed no UI: the indicator
	// was in a function the keybind does not call. It also means this is genuine
	// hold-to-talk, not a toggle.
	bIsTalking = bNowOn;

	if (AOCBaseHUD(myHUD) != none
		&& AOCBaseHUD(myHUD).HUD != none
		&& AOCBaseHUD(myHUD).HUD.MainHUD != none)
	{
		AOCBaseHUD(myHUD).HUD.MainHUD.LocalPlayerStartTalking(bNowOn);
	}
}

/** Reports every value that decides whether voice can work. Type VoiceDebug. */
/**
 * Print a line every time the voice interface reports someone else talking.
 *
 * The talking indicator you see when YOU press the key is LocalPlayerStartTalking, driven by
 * your own keypress -- it lights up with the network dead. This is the other direction, and
 * is the only client-side evidence that voice data is actually arriving.
 */
/**
 * Ground truth from the voice interface, bypassing the talking delegate entirely.
 *
 * TalkingDelegates is filled from script but only ever invoked natively, so if it never
 * fires there is nothing script-side to inspect. These two calls are the real state:
 * IsLocalPlayerTalking says whether Steam is capturing our mic, IsRemotePlayerTalking says
 * whether this client considers someone else a live talker. Together they split capture
 * from transport, which the HUD indicator cannot.
 */
exec function VoiceStatus()
{
	local OnlineVoiceInterface VI;
	local LocalPlayer LP;
	local PlayerReplicationInfo PRI;
	local int i, Others;

	LP = LocalPlayer(Player);
	VI = VoiceInterface;
	if (VI == none && OnlineSub != none)
		VI = OnlineSub.VoiceInterface;

	ClientDisplayConsoleMessage("---- BangMod voice status ----");
	if (VI == none || LP == none)
	{
		ClientDisplayConsoleMessage("No voice interface or no local player - nothing else can work.");
		return;
	}

	ClientDisplayConsoleMessage("Headset/mic present:" @ VI.IsHeadsetPresent(LP.ControllerId));
	ClientDisplayConsoleMessage("Capturing my mic:" @ VI.IsLocalPlayerTalking(LP.ControllerId)
		@ "<-- hold the key and re-run; false here means Steam is not recording");

	if (WorldInfo.GRI == none)
	{
		ClientDisplayConsoleMessage("No GRI yet.");
		return;
	}

	for (i = 0; i < WorldInfo.GRI.PRIArray.Length; i++)
	{
		PRI = WorldInfo.GRI.PRIArray[i];
		if (PRI == none || PRI == PlayerReplicationInfo)
			continue;

		Others++;
		ClientDisplayConsoleMessage("  " $ PRI.PlayerName $ ": talking=" $ VI.IsRemotePlayerTalking(PRI.UniqueId));
	}

	if (Others == 0)
		ClientDisplayConsoleMessage("  (nobody else on the server)");
	ClientDisplayConsoleMessage("------------------------------");
}

/**
 * Register every other player with Steam's voice layer and clear any Steam-side mute.
 *
 * There are two mute layers and only one of them is ever touched. The engine's
 * GameplayVoiceMuteList / VoicePacketFilter decides what the SERVER relays;
 * MuteRemoteTalker / UnmuteRemoteTalker / MuteAll / UnmuteAll are Steam's own per-talker
 * state on THIS client. Nothing in AOC, UTGame or BangMod calls the second set at all, and
 * nothing script-side registers remote talkers in a net game -- the engine comment at
 * UTPlayerController.uc:469 says that happens automatically, which is only checkable by
 * doing it and seeing whether it changes anything.
 *
 * So this is the one lever script has on the receive path. Safe to run repeatedly:
 * registering an already-registered talker and unmuting an unmuted one are both no-ops.
 */
exec function VoiceFix()
{
	BangModVoiceSweep();
	ClientDisplayConsoleMessage("VoiceFix applied - run VoiceStatus, then have someone talk.");
}

function BangModVoiceSweep()
{
	local OnlineVoiceInterface VI;
	local LocalPlayer LP;
	local PlayerReplicationInfo PRI;
	local int i;

	LP = LocalPlayer(Player);
	if (LP == none)
		return;

	VI = VoiceInterface;
	if (VI == none && OnlineSub != none)
		VI = OnlineSub.VoiceInterface;
	if (VI == none || WorldInfo.GRI == none)
		return;

	VI.UnmuteAll(LP.ControllerId);

	for (i = 0; i < WorldInfo.GRI.PRIArray.Length; i++)
	{
		PRI = WorldInfo.GRI.PRIArray[i];
		if (PRI == none || PRI == PlayerReplicationInfo)
			continue;

		VI.RegisterRemoteTalker(PRI.UniqueId);
		VI.UnmuteRemoteTalker(LP.ControllerId, PRI.UniqueId, false);
	}
}

/** Re-sweep periodically so players who join later are picked up too. */
function BangModVoiceSweepTick()
{
	if (bBangModVoiceAutoRegister)
		BangModVoiceSweep();
}

exec function VoiceTrace(optional bool bOn = true)
{
	bBangModVoiceTrace = bOn;
	ClientDisplayConsoleMessage("VoiceTrace" @ (bOn ? "ON - talk and watch for lines" : "off"));
}

exec function VoiceDebug()
{
	local LocalPlayer LP;

	LP = LocalPlayer(Player);

	ClientDisplayConsoleMessage("---- BangMod voice state ----");
	ClientDisplayConsoleMessage("OnlineSub:" @ OnlineSub);
	ClientDisplayConsoleMessage("PC.VoiceInterface:" @ VoiceInterface);
	if (OnlineSub != none)
		ClientDisplayConsoleMessage("OnlineSub.VoiceInterface:" @ OnlineSub.VoiceInterface @ " <-- must be non-None");
	ClientDisplayConsoleMessage("LocalPlayer:" @ LP @ "| ControllerId:" @ (LP != none ? string(LP.ControllerId) : "n/a"));
	ClientDisplayConsoleMessage("bEnableProximityChat:" @ bEnableProximityChat @ "| bIsTalking:" @ bIsTalking);
	ClientDisplayConsoleMessage("NetMode:" @ int(WorldInfo.NetMode) @ "| bRequiresPushToTalk:" @ (WorldInfo.Game != none ? string(WorldInfo.Game.bRequiresPushToTalk) : "server-only"));

	// The numbers that decide saturation. "Connection saturated!" is the stat net HUD
	// reporting IsNetReady(0) == false, and that is judged against CurrentNetSpeed --
	// NOT against whatever the ini says. Raising MaxInternetClientRate and
	// ConfiguredInternetSpeed only matters if it actually lands here, and nothing so far
	// has confirmed that it does. Read it rather than assume it.
	if (Player != none)
		ClientDisplayConsoleMessage("CurrentNetSpeed:" @ Player.CurrentNetSpeed @ "  <-- the value saturation is judged against");
	ClientDisplayConsoleMessage("ClientCap:" @ ClientCap @ " (non-zero = the server capped us via ClientCapBandwidth)");

	// Client move send rate. AOCPlayerController.ReplicateMove hardcodes 0.05s on a
	// dedicated server -- 20 Hz. Every deferred packet therefore costs a 50 ms hole in
	// what the server knows about your position, which is why a little saturation feels
	// like a lot of rubber-banding.
	ClientDisplayConsoleMessage("Move send interval: 0.05s (20 Hz) on dedicated -- AOCPlayerController.uc:9239");
	ClientDisplayConsoleMessage("Auto-netspeed: config=" $ iBangModMinNetSpeed @ "fallback=" $ iBangModMinNetSpeedFallback @ "tries=" $ iBangModNetSpeedTries @ "last=" $ nBangModNetSpeedBlock);
	ClientDisplayConsoleMessage("-----------------------------");
}

/**
 * Raise this client's own send budget at runtime. Usage: BangModNetSpeed 100000, then hold
 * push-to-talk and check stat net.
 *
 * "Connection saturated!" is IsNetReady(0) judged against Player.CurrentNetSpeed, not any
 * ini value. AOCGame.uc:1810 caps it at login via ClientCapBandwidth, so the server's view
 * at that instant becomes a hard ceiling. An exec rather than automatic: it changes only
 * what this client pushes upstream, which should be a measured decision.
 */
/**
 * Undo the login bandwidth cap that makes push-to-talk unusable.
 *
 * Measured: a live client sat at CurrentNetSpeed 10000 while its ini asked for 100000, and
 * push-to-talk pushed ~9951 B/s -- pinned at the ceiling, so stat net read "Connection
 * saturated!". ReplicateMove hardcodes 0.05s (20 Hz) on dedicated, so every deferred packet
 * is a 50 ms hole in the server's view of your position. That is the rubber-banding.
 *
 * The cap is AOCGame.uc:1810 -> ClientCapBandwidth -> SetNetSpeed at PostLogin, which is why
 * editing MaxInternetClientRate changed nothing.
 *
 * 15000 because that is where the engine clamps -- 0x3A98 is a hardcoded immediate in the
 * net driver, and SetNetSpeed(100000) was observed landing on exactly 15000. This only
 * raises what THIS client sends. Set iBangModMinNetSpeed negative to opt out.
 */
simulated function BangModRestoreNetSpeed()
{
	local int Target;

	// Every bail-out records WHY. The automatic path was reported as doing nothing while
	// the identical SetNetSpeed call from the BangModNetSpeed exec worked, so the
	// difference has to be one of these guards -- and naming which one beats another
	// round of me speculating about it.
	if (Player == none)
	{
		nBangModNetSpeedBlock = 'Player_is_none';
		return;
	}
	// 0 means "config never delivered a value" -- fall back rather than do nothing.
	Target = iBangModMinNetSpeed;
	if (Target == 0)
		Target = default.iBangModMinNetSpeedFallback;

	if (Target < 0)
	{
		nBangModNetSpeedBlock = 'opted_out';
		return;
	}
	if (!IsLocalPlayerController())
	{
		nBangModNetSpeedBlock = 'not_local_PC';
		return;
	}
	if (Player.CurrentNetSpeed >= Target)
	{
		nBangModNetSpeedBlock = 'already_at_or_above';
		return;
	}

	iBangModNetSpeedTries++;
	SetNetSpeed(Target);

	// Did the call actually stick? If SetNetSpeed silently refuses in this context the
	// value will not have moved, and that is a different problem from never being called.
	if (Player.CurrentNetSpeed < Target)
		nBangModNetSpeedBlock = 'SetNetSpeed_refused';
	else
		nBangModNetSpeedBlock = 'applied';
}

/** The server caps us here at login; put it back afterwards. */
reliable client function ClientCapBandwidth(int Cap)
{
	super.ClientCapBandwidth(Cap);
	BangModRestoreNetSpeed();
}

exec function BangModNetSpeed(int NewSpeed)
{
	if (Player == none)
		return;

	if (NewSpeed < 1800)
	{
		ClientDisplayConsoleMessage("Refusing" @ NewSpeed $ ": UE3 treats anything under 1800 as unusable.");
		return;
	}

	ClientDisplayConsoleMessage("CurrentNetSpeed" @ Player.CurrentNetSpeed @ "->" @ NewSpeed
		@ "(ClientCap was" @ ClientCap $ ")");
	SetNetSpeed(NewSpeed);
	ClientDisplayConsoleMessage("Now:" @ Player.CurrentNetSpeed);
}

exec function GBA_ToggleSpeaking()
{
	// Fallback only. On a stock config the input alias above means this never runs;
	// it is here for anyone whose bindings lack the alias, and it toggles rather than
	// holds because a bare exec has no release event to hang StopNetworkedVoice on.
	if (!bEnableProximityChat)
	{
		ClientDisplayConsoleMessage("Proximity voice chat is disabled. Enable in config.");
		return;
	}

	ToggleSpeaking(!bIsTalking);
}

// NOTE: Server-side proximity notification disabled due to voice codec being missing from engine
// The functions below are kept for reference but commented out to avoid compilation errors
/*
// Notify server we're talking (so it can replicate to nearby clients)
reliable server function ServerNotifyTalkingState(bool bTalking)
{
	bIsTalking = bTalking;
	NotifyNearbyPlayersOfTalker(bTalking);
}

// Check which players are in range and notify them
function NotifyNearbyPlayersOfTalker(bool bTalking)
{
	// Would need to iterate controllers and call ClientReceiveProximityTalker
	// But this causes compile errors due to type casting limitations
	// Disabled since voice codec is missing anyway
	ClientDisplayConsoleMessage("Proximity Voice: " $ PlayerReplicationInfo.PlayerName $ (bTalking ? " is talking" : " stopped"));
}
*/

// Receive notification that someone nearby is talking
reliable client function ClientReceiveProximityTalker(PlayerReplicationInfo TalkerPRI, bool bTalking)
{
	local int i;
	local VOIPInfo NewTalker;
	local AOCPRI APRI;
	
	APRI = AOCPRI(TalkerPRI);
	if (APRI == none)
		return;
	
	if (bTalking)
	{
		// Add to nearby talkers list
		if (NearbyTalkers.Find(APRI) == INDEX_NONE)
		{
			NearbyTalkers.AddItem(APRI);
		}
		
		// Update HUD to show this person is talking
		if (AOCBaseHUD(myHUD) != none)
		{
			NewTalker.VOIPName = APRI.PlayerName;
			NewTalker.LastUpdateTime = WorldInfo.TimeSeconds;
			NewTalker.TalkerTeam = EFAC_ALL;
			
			// Add to the talking list in HUD
			for (i = 0; i < AOCBaseHUD(myHUD).AllPlayersTalking.Length; i++)
			{
				if (AOCBaseHUD(myHUD).AllPlayersTalking[i].VOIPName == APRI.PlayerName)
				{
					AOCBaseHUD(myHUD).AllPlayersTalking[i].LastUpdateTime = WorldInfo.TimeSeconds;
					return;  // Already in list, just updated time
				}
			}
			
			// Not in list, add them
			AOCBaseHUD(myHUD).AllPlayersTalking.AddItem(NewTalker);
		}
	}
	else
	{
		// Remove from nearby talkers
		NearbyTalkers.RemoveItem(APRI);
		
		// Queue for removal from HUD
		if (AOCBaseHUD(myHUD) != none)
		{
			for (i = 0; i < AOCBaseHUD(myHUD).AllPlayersTalking.Length; i++)
			{
				if (AOCBaseHUD(myHUD).AllPlayersTalking[i].VOIPName == APRI.PlayerName)
				{
					AOCBaseHUD(myHUD).QueueToRemove.AddItem(AOCBaseHUD(myHUD).AllPlayersTalking[i]);
					break;
				}
			}
		}
	}
}

// Override ClientNotifyPlayerTalking to handle proximity filtering
/**
 * Fires when any player's talking state changes. Registered as the Steamworks talking
 * delegate at AOCPlayerController.uc:1067, so a call here means voice data arrived.
 *
 * Rewritten from a foreach DynamicActors sweep that ran on every notification -- Steam
 * raises those every 0.2s per talker, so holding the key meant a full actor sweep several
 * times a second, and a hitching client stops sending ServerMove on time. That was likely
 * the push-to-talk rubber-banding rather than anything wrong with voice itself.
 *
 * It was also broken: PRI.Owner is a Controller, so Pawn(PRI.Owner) always cast to none and
 * the proximity test could never pass. GRI.PRIArray is the replicated list, already
 * maintained, no iteration needed.
 */
function ClientNotifyPlayerTalking(UniqueNetId TalkingPlayer, bool bIsTalking)
{
	local PlayerReplicationInfo PRI;
	local Controller OwnerC;
	local int i;

	// This only fires when the Steamworks voice interface reports a REMOTE talker, so
	// seeing a line here is proof that voice data is reaching this machine. Traced before
	// the gates below, which can drop the notification for reasons unrelated to transport.
	if (bBangModVoiceTrace)
		ClientDisplayConsoleMessage("VoiceTrace: remote talker" @ TalkingPlayer.Uid.A $ ":" $ TalkingPlayer.Uid.B
			@ "talking=" $ bIsTalking);

	if (!bEnableProximityChat || WorldInfo.GRI == none || Pawn == none)
		return;

	for (i = 0; i < WorldInfo.GRI.PRIArray.Length; i++)
	{
		PRI = WorldInfo.GRI.PRIArray[i];
		if (PRI == none || PRI.UniqueId != TalkingPlayer)
			continue;

		// Owner is the Controller; its Pawn is what has a location.
		OwnerC = Controller(PRI.Owner);
		if (OwnerC != none && OwnerC.Pawn != none
			&& VSize(Pawn.Location - OwnerC.Pawn.Location) <= ProximityChatDistance)
		{
			ClientReceiveProximityTalker(PRI, bIsTalking);
		}
		return;
	}
}

// Process VOIP queue to update HUD
function ProcessVOIPQueue()
{
	local int i;
	local float CurrentTime;
	local array<VOIPInfo> CurrentTalkers;
	
	if (AOCBaseHUD(myHUD) == none)
		return;
		
	CurrentTime = WorldInfo.TimeSeconds;
	
	// Remove old talkers (haven't updated in 0.5 seconds)
	for (i = AOCBaseHUD(myHUD).AllPlayersTalking.Length - 1; i >= 0; i--)
	{
		if (CurrentTime - AOCBaseHUD(myHUD).AllPlayersTalking[i].LastUpdateTime > 0.5)
		{
			AOCBaseHUD(myHUD).AllPlayersTalking.Remove(i, 1);
		}
	}
	
	// Process removal queue
	for (i = 0; i < AOCBaseHUD(myHUD).QueueToRemove.Length; i++)
	{
		AOCBaseHUD(myHUD).AllPlayersTalking.RemoveItem(AOCBaseHUD(myHUD).QueueToRemove[i]);
	}
	AOCBaseHUD(myHUD).QueueToRemove.Length = 0;
	
	// Build current talkers array for HUD
	CurrentTalkers = AOCBaseHUD(myHUD).AllPlayersTalking;
	
	// Update the HUD display
	if (AOCBaseHUD(myHUD).HUD != none && AOCBaseHUD(myHUD).HUD.MainHUD != none)
	{
		AOCBaseHUD(myHUD).HUD.MainHUD.RegisterCurrentTalkers(CurrentTalkers);
	}
}

/* ==================== Inebriate on any map ==================================
 *
 * The drunk effect is gated by the active post-process chain, not by the map. The default
 * is ChivPostProcess_noToneMap; the drunk nodes live in the sibling ChivPostProcess_drunk,
 * which maps opt into -- hence its reputation for being TO2-only. Both are base-game
 * assets, so the chain can be selected anywhere.
 *
 * It is a REPLACEMENT, not an add-on. ChivPostProcess_drunk is a complete chain, so
 * appending it runs two full chains back to back and the scene is uber-post-processed
 * twice -- blocky smeared garbage. Swap it, as GameInfo.uc:1585-1592 does:
 * RemoveAllPostProcessingChains, InsertPostProcessingChain, NotifyBindPostProcessEffects.
 *
 * Sobering up restores the world chain the same way. AOCPlayerController's GUI chain is
 * collateral but re-inserts itself on demand (:8659). All client-side.
 * ============================================================================= */

/** True when the active chain can already render the drunk effect. */
simulated function bool BangModHasDrunkEffects()
{
	local LocalPlayer LP;

	LP = LocalPlayer(Player);
	if (LP == none || LP.PlayerPostProcess == none)
		return false;

	// Both are needed: ToggleDrunkPostEffects dereferences BlackoutEffect and its material
	// instance with no none-check, so a chain with only one of the two is worse than neither.
	return LP.PlayerPostProcess.FindPostProcessEffect('drunkeffect') != none
		&& LP.PlayerPostProcess.FindPostProcessEffect('blackout') != none;
}

/** Makes the drunk effect available on this map, if it is not already. */
simulated function bool BangModEnsureDrunkChain()
{
	local LocalPlayer LP;

	if (BangModHasDrunkEffects())
		return true;                          // map already brought a chain with it

	LP = LocalPlayer(Player);
	if (LP == none || myHUD == none || BangModDrunkChain == none)
		return false;

	// Replace, do not append -- see the note above. bInClone deep-copies the effects so the
	// shared asset is never mutated by one player's session.
	LP.RemoveAllPostProcessingChains();
	if (!LP.InsertPostProcessingChain(BangModDrunkChain, INDEX_NONE, true))
	{
		// Put the map back the way it was rather than leaving the player with no chain.
		BangModRestoreWorldChain();
		return false;
	}

	// Re-cache AOCBaseHUD's DrunkEffect / BlackoutEffect pointers against the new chain.
	myHUD.NotifyBindPostProcessEffects();

	bBangModDrunkChainAdded = BangModHasDrunkEffects();
	if (!bBangModDrunkChainAdded)
		BangModRestoreWorldChain();

	return bBangModDrunkChainAdded;
}

/** Puts the map's own post-process chain back. Mirrors GameInfo.uc:1585-1592. */
simulated function BangModRestoreWorldChain()
{
	local LocalPlayer LP;
	local PostProcessChain WorldChain;

	LP = LocalPlayer(Player);
	if (LP == none)
		return;

	// Static on Engine (Engine.uc:1042). Reached through class'Engine'.static rather than
	// LP.Outer so this does not depend on LocalPlayer's within-class.
	WorldChain = class'Engine'.static.GetWorldPostProcessChain();
	if (WorldChain == none)
		WorldChain = class'Engine'.static.GetDefaultPostProcessChain();

	LP.RemoveAllPostProcessingChains();
	if (WorldChain != none)
		LP.InsertPostProcessingChain(WorldChain, INDEX_NONE, true);

	if (myHUD != none)
		myHUD.NotifyBindPostProcessEffects();
}

/**
 * Undoes BangModEnsureDrunkChain. Guarded on the flag so that a map which supplied its own
 * drunk chain keeps it -- on those maps we never swapped anything and must not "restore".
 */
simulated function BangModDropDrunkChain()
{
	if (!bBangModDrunkChainAdded)
		return;

	bBangModDrunkChainAdded = false;
	BangModRestoreWorldChain();
}

/**
 * Adds the chain first when the map has no drunk effect of its own, so inebriate works
 * everywhere rather than only where the map happened to supply one.
 *
 * The sound mode is deliberately not touched here: AOCBaseHUD drives EnableDrunkSoundMode
 * from its own fade (UpdateDrunkEffect on the way in, ToggleDrunkPostEffects on the way
 * out), and that runs on this same client.
 */
reliable client function ClientInebriate(bool bEnable)
{
	if (AOCBaseHUD(myHUD) == none)
		return;

	if (bEnable)
	{
		if (!BangModEnsureDrunkChain())
		{
			ClientDisplayConsoleMessage("Inebriate: no drunk post-process chain available on this map.");
			return;
		}
		super.ClientInebriate(true);
		return;
	}

	super.ClientInebriate(false);
	BangModDropDrunkChain();
}


DefaultProperties
{
	NetUpdateFrequency=120
	// Netcode optimization: Client-side interpolation interval to match 120Hz tickrate
	MaxClientUpdateInterval=0.00833  // 1/120 = 0.00833 seconds between client updates
	suicideDelay = 1.0f
	UnpauseCountdownTime = 3
	CustomizationClass=class'BangModCustomization'
	// Sibling of the default chain (ChivPostProcess_noToneMap) in the same base-game
	// package, so referencing it costs no new content on any map.
	BangModDrunkChain=PostProcessChain'CHV_PPC_Pack.PostProcessChain.ChivPostProcess_drunk'
	bShowDeathMessages = true
	
	// Proximity voice chat defaults
	ProximityChatDistance=2048.0  // About 39 meters (typical medieval battle communication range)
	bBangModVoiceAutoRegister=true
	iBangModMinNetSpeed=15000
	iBangModMinNetSpeedFallback=15000
	bEnableProximityChat=true
	bIsTalking=false

	// Parry box toggle default (disabled = use vanilla AOC values until an admin enables BangMod parry)
	bBangModParryBox=false
	// Skeletal parry default (disabled = use directional/shield-style parry box)
	bSkeletalParry=false
	// Butt-parry prevention default (disabled = attacks from behind are parryable, vanilla behaviour)
	bDisableButtParries=false

	// Collision bubble radius default (39.0 = vanilla AOC OuterCylinder radius)
	fBangModCollisionRadius=39.0

}

