reliable server function S_AdminSetCollisionRadius(float NewRadius) {
	local AOCPlayerController PC;

	if (!IsAdmin())
		return;

	// Clamp to a sane range to prevent griefing (1 to 200)
	NewRadius = FClamp(NewRadius, 1.0, 200.0);

	class'BangModAOCDuelPlayerController'.default.fBangModCollisionRadius = NewRadius;
	class'BangModAOCDuelPlayerController'.static.StaticSaveConfig();

	// Sync all connected players
	foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
	{
		if (BangModAOCDuelPlayerController(PC) != none)
			BangModAOCDuelPlayerController(PC).ClientSyncCollisionRadius(NewRadius);
	}

	S_AdminBroadcastMessage("Collision bubble radius set to" @ NewRadius @ "(respawn to apply)", false);
}

