// XangMod - Server.uci
// Included via XangModGame.uci. Vars live in Game/Vars.uci; DefaultProperties in Game/Server.uci (last).
reliable server function S_BroadcastServerMessage(string Message)
{
    local AOCPlayerController PC;
    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        PC.ReceiveChatMessage(Message, EFAC_ALL, false, false, , false);
    }
}

/**
 * Enforce admin mute server-side instead of trusting the client.
 *
 * Vanilla only checks bIsAdminMuted in AOCPlayerController.ReceiveChatMessage, and skips it
 * for Steam friends of the sender and for the sender's own copy -- so a muted player still
 * sees their chat go through, which looks exactly like mute being broken. Dropping it here
 * means it never reaches the wire.
 */
function BroadcastMessage(PlayerController Sender, string Message, EAOCFaction DesignatedTeam, optional bool bSystemMessage = false, optional bool bUseCustomColor = false, optional string Col)
{
    local AOCPRI SenderPRI;
    local AOCPlayerController SenderPC;

    SenderPC = AOCPlayerController(Sender);

    if (!bSystemMessage && SenderPC != none)
    {
        SenderPRI = AOCPRI(SenderPC.PlayerReplicationInfo);
        if (SenderPRI != none && SenderPRI.bIsAdminMuted)
        {
            // Tell the sender only, so mute is not silently confusing to them.
            SenderPC.ReceiveChatMessage("You are muted by an admin.", EFAC_ALL, false, true, "#FF5555");
            return;
        }
    }

    // !rankedhelp: shown to everyone at most once per 30s; the typed line is never shown.
    if (!bSystemMessage && SenderPC != none && Locs(Repl(Message, " ", "")) == "!rankedhelp")
    {
        if (LastRankedHelpTime == 0 || WorldInfo.RealTimeSeconds - LastRankedHelpTime >= 30.0)
        {
            LastRankedHelpTime = WorldInfo.RealTimeSeconds;
            SendRankedHelp(SenderPC);
        }
        return;
    }

    super.BroadcastMessage(Sender, Message, DesignatedTeam, bSystemMessage, bUseCustomColor, Col);
}

/** The !rankedhelp reply. Admin lines go only to the admin who asked. */
function SendRankedHelp(AOCPlayerController Asker)
{
    local array<string> Lines;
    local string Line;
    local AOCPlayerController PC;

    if (Ranked == none)
        Lines.AddItem("Ranked is not available on this map.");
    else
        Lines.AddItem("Ranked is" @ (Ranked.bRankedEnabled ? "ON" : "OFF") @ "on this server.");
    Lines.AddItem("To play: while ranked is on, pick a team and class to queue.");
    Lines.AddItem("Any even number of players makes a match (2v2, 3v3, ...); it starts 30s after enough join.");
    Lines.AddItem("voteranked (console): start a vote to turn ranked on.");
    Lines.AddItem("voteunranked (console): start a vote to turn it off (between matches).");

    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        foreach Lines(Line)
            PC.ReceiveChatMessage(Line, EFAC_ALL, false, true, class'XangModRanked'.const.CHAT_COLOUR, false);
    }

    if (Asker.PlayerReplicationInfo == none || !Asker.PlayerReplicationInfo.bAdmin)
        return;

    Lines.Length = 0;
    Lines.AddItem("Admin: admin RankedMode 1|0 -- turn ranked on/off.");
    Lines.AddItem("Admin: adminstartmatch -- start now with an even number queued (any size).");
    Lines.AddItem("Admin: adminterminatematch -- end the ranked match, no Elo changes.");
    Lines.AddItem("Admin: admin RankedExtend [seconds] / admin RankedAbandon -- during a leaver pause.");
    Lines.AddItem("Admin: admin RankedMinTeamSize <n> / admin RankedMaxTeamSize <n> -- match size, per side.");

    foreach Lines(Line)
        Asker.ReceiveChatMessage(Line, EFAC_ALL, false, true, class'XangModRanked'.const.CHAT_COLOUR, false);
}

/**
 * Recognize only the published ChivAdmin listener. A string comparison avoids making
 * that optional Workshop package a compile-time dependency or replacing other mods.
 */
function bool XangModIsChivAdminListener(AOCRCon RCon)
{
	return RCon != none && !RCon.bDeleteMe
		&& string(RCon.Class) ~= "ChivAdmin.ChivAdminRCon";
}

/**
 * Spawn XangMod's remote console instead of the vanilla one. AOCGame.InitRemoteConsole
 * hardcodes Spawn(class'AOCRCon'), so this is the only hook needed -- XangModRCon extends
 * AOCRCon, so vanilla opcodes, auth and the GameEvent_* calls keep working untouched.
 * Keep a valid XangMod listener across travel. A vanilla listener cannot emit Heir's
 * round frames, even though its base RCON events still work.
 */
function InitRemoteConsole(string Options)
{
	local AOCRCon RCon, ChivAdmin;
	local XangModRCon Listener, Candidate;
	local int RequiredPort;
	local bool bPortConflict;

	if (WorldInfo.NetMode != NM_DedicatedServer)
		return;

	// Mutator initialization runs first and may overwrite the route without destroying
	// the carried XangMod actor. Remember the exact actor it installed before selection.
	if (XangModIsChivAdminListener(RemoteConsole))
		ChivAdmin = RemoteConsole;

	// The effective configured default for a newly spawned XangModRCon. An existing
	// listener can have a different instance port, so validate reuse against its own port.
	RequiredPort = class'XangModRCon'.default.RConPort;
	Listener = XangModRCon(RemoteConsole);
	if (Listener != none && !Listener.XangModCanReuseListener(Listener.RConPort))
		Listener = none;
	RemoteConsole = none;

	// A class-default comparison can reject a valid carried listener if its instance port
	// differs. Prefer a valid listening actor, then the one holding more sessions.
	foreach WorldInfo.AllActors(class'XangModRCon', Candidate)
	{
		if (Candidate == Listener || !Candidate.XangModCanReuseListener(Candidate.RConPort))
			continue;
		if (Listener == none
			|| (!Listener.XangModIsListening() && Candidate.XangModIsListening())
			|| (Listener.XangModIsListening() == Candidate.XangModIsListening()
				&& Candidate.Sessions.Length > Listener.Sessions.Length))
			Listener = Candidate;
	}

	// With no working XangMod listener, recover the host's ChivAdmin endpoint even when
	// the game route was cleared. An empty retry actor on the default port is not evidence
	// that clients use that port. Reuse a matching XangMod actor or spawn one below.
	if (Listener == none || (!Listener.XangModIsListening() && Listener.Sessions.Length == 0))
	{
		if (ChivAdmin == none)
		{
			foreach WorldInfo.AllActors(class'AOCRCon', RCon)
			{
				if (XangModIsChivAdminListener(RCon))
				{
					ChivAdmin = RCon;
					break;
				}
			}
		}
		if (ChivAdmin != none)
		{
			RequiredPort = ChivAdmin.RConPort;
			if (Listener != none && Listener.RConPort != RequiredPort)
				Listener = none;
			foreach WorldInfo.AllActors(class'XangModRCon', Candidate)
			{
				if (Candidate.XangModCanReuseListener(RequiredPort)
					&& (Listener == none || Candidate.Sessions.Length > Listener.Sessions.Length))
					Listener = Candidate;
			}
		}
	}
	if (Listener != none)
		RequiredPort = Listener.RConPort;

	// Retire only unbound retry actors with no sessions. A failed readiness check can still
	// describe a native listening socket, so it is not sufficient evidence for destruction.
	if (Listener != none)
	{
		foreach WorldInfo.AllActors(class'XangModRCon', Candidate)
		{
			if (Candidate == Listener || Candidate.bDeleteMe || XangModRConSession(Candidate) != none
				|| Candidate.ParentLink != none || Candidate.RConPort != Listener.RConPort)
				continue;

			if (!Candidate.XangModIsIdleListener())
			{
				LogAlwaysInternal("[XangModRCon] another XangMod listener is not an idle retry actor on port" @ Candidate.RConPort
					@ string(Candidate) @ "- left in place; inspect AdminRConStatus");
				continue;
			}

			LogAlwaysInternal("[XangModRCon] retiring idle duplicate listener" @ string(Candidate));
			if (!Candidate.Destroy())
				LogAlwaysInternal("[XangModRCon] failed to retire idle duplicate listener" @ string(Candidate));
		}
	}

	if (Listener == none)
	{
		// Check for foreign conflicts before changing any actor. If replacement cannot
		// proceed, leave every existing socket intact.
		foreach WorldInfo.AllActors(class'AOCRCon', RCon)
		{
			if (RCon.bDeleteMe || XangModRConSession(RCon) != none || RCon.RConPort != RequiredPort)
				continue;

			if (RCon.Class != class'AOCRCon' && !XangModIsChivAdminListener(RCon))
			{
				bPortConflict = true;
				LogAlwaysInternal("[XangModRCon] possible listener conflict: another actor is configured for port"
					@ RequiredPort @ string(RCon));
			}
		}

		if (bPortConflict)
		{
			LogAlwaysInternal("[XangModRCon] cannot select a valid listener on port" @ RequiredPort
				@ "- Heir round telemetry is unavailable; inspect AdminRConStatus and the listener logs");
			return;
		}
	}

	// ChivAdmin's independent ping timer can mask a broken game-event route. Its mutator
	// may stay installed, but XangMod must own the event socket to emit round frames.
	// Retire its current target and same-port duplicates, including an unbound actor that
	// the mutator just spawned during travel. Keep the carried XangMod sessions intact.
	foreach WorldInfo.AllActors(class'AOCRCon', RCon)
	{
		if (!XangModIsChivAdminListener(RCon)
			|| (RCon != ChivAdmin && RCon.RConPort != RequiredPort))
			continue;

		LogAlwaysInternal("[XangModRCon] replacing ChivAdmin listener" @ string(RCon)
			@ "on port" @ RCon.RConPort @ "- XangMod will serve port" @ RequiredPort);
		RCon.Close();
		if (!RCon.Destroy())
		{
			RemoteConsole = Listener;
			LogAlwaysInternal("[XangModRCon] failed to retire ChivAdmin listener; replacement aborted");
			return;
		}
	}

	if (Listener == none)
	{
		// Retire vanilla itself, never another mod's actor or an accepted session.
		foreach WorldInfo.AllActors(class'AOCRCon', RCon)
		{
			if (RCon.bDeleteMe || RCon.Class != class'AOCRCon' || RCon.RConPort != RequiredPort)
				continue;

			LogAlwaysInternal("[XangModRCon] replacing vanilla listener on port" @ RequiredPort @ string(RCon));
			RCon.Close();
			if (!RCon.Destroy())
			{
				LogAlwaysInternal("[XangModRCon] failed to retire vanilla listener; Heir round telemetry is unavailable");
				return;
			}
		}

		Listener = Spawn(class'XangModRCon');
		// PostBeginPlay sets AcceptClass; native binding happens on the next Tick.
		// Preserve the retired endpoint's port without changing class defaults or config.
		if (Listener != none)
			Listener.RConPort = RequiredPort;
	}
	else if (!Listener.XangModIsListening())
	{
		// Keep the existing bind/retry actor and its event route. Do not create another
		// listener or destroy unrelated actors merely because their config matches.
		foreach WorldInfo.AllActors(class'AOCRCon', RCon)
		{
			if (RCon != Listener && !RCon.bDeleteMe && XangModRConSession(RCon) == none && RCon.RConPort == Listener.RConPort)
				LogAlwaysInternal("[XangModRCon] pending listener: another actor is configured for port"
					@ Listener.RConPort @ string(RCon) @ "- inspect socket ownership if binding keeps failing");
		}
	}

	if (Listener == none)
	{
		LogAlwaysInternal("[XangModRCon] failed to spawn a listener; Heir round telemetry is unavailable");
		return;
	}

	RemoteConsole = Listener;
	if (Listener.XangModIsListening())
		LogAlwaysInternal("[XangModRCon] game events routed to listening actor" @ string(Listener) @ "on port" @ Listener.RConPort
			@ "with" @ Listener.Sessions.Length @ "session(s)");
	else
		LogAlwaysInternal("[XangModRCon] game events routed to actor" @ string(Listener)
			@ "- waiting for its listener to bind port" @ Listener.RConPort);

	// The travel-time push reported the map being left, so announce the real one now that
	// it is current. Sessions survive travel, so this reaches everyone already connected.
	RemoteConsole.GameEvent_MapChanged(GetCurrentMap(), MapCycleIndex);
}

/**
 * Carry the RCON sessions across a seamless map change, not just the listener. Without
 * this the session actors are destroyed with the old world and every connected client
 * drops on each map change.
 *
 * Only does anything if the travel is actually seamless -- a full ServerTravel tears down
 * the world regardless, and clients must reconnect.
 */
function GetSeamlessTravelActorList(bool bToEntry, out array<Actor> ActorList)
{
	local XangModRCon Listener;
	local int i;

	super.GetSeamlessTravelActorList(bToEntry, ActorList);

	Listener = XangModRCon(RemoteConsole);
	if (Listener == none)
		return;

	ActorList[ActorList.Length] = Listener;

	for (i = 0; i < Listener.Sessions.Length; i++)
	{
		if (Listener.Sessions[i] != none)
			ActorList[ActorList.Length] = Listener.Sessions[i];
	}

	LogAlwaysInternal("[XangModRCon] carrying" @ Listener.Sessions.Length @ "session(s) through travel");
}

DefaultProperties
{
    // Five minutes. Long enough that a real match night never trips it, short enough that a
    // stuck server recovers on its own instead of needing a restart. 0 disables.
    fXangModTournamentHoldLimit=300.0
    bEnableCompForestAlternatingSpawns=false
    iXangModCompForestLastStage=-1
    iXangModCompForestLastAgathaGroup=-1
    iXangModCompForestLastMasonGroup=-1

    PlayerControllerClass=class'`{GAMEMODE}PlayerController'
    DefaultPawnClass=class'`{GAMEMODE}Pawn'
    HUDType=class'`{GAMEMODE}HUD'
    PlayerReplicationInfoClass=class'`{GAMEMODE}PRI'

    // "addbots" bot AI: smarter melee bots (skill floor + better threat awareness).
    // See XangMod/Classes/XangModAOCCombatBot.uc. Shared by every XangMod game mode.
    DefaultAIControllerClass=class'XangModAOCCombatBot'

    //This is the name that shows in the server browser for this mod:
    ModDisplayString="SlumpMod 2.5.0"

    Families.Empty;
    Families(ECLASS_Archer)=class'XangModFamilyInfo_Agatha_Archer'
    Families(ECLASS_ManAtArms)=class'XangModFamilyInfo_Agatha_ManAtArms'
    Families(ECLASS_Vanguard)=class'XangModFamilyInfo_Agatha_Vanguard'
    Families(ECLASS_Knight)=class'XangModFamilyInfo_Agatha_Knight'
    Families(ECLASS_SiegeEngineer)=class'XangModFamilyInfo_Agatha_Assassin'
    Families(5)=class'XangModFamilyInfo_Mason_Archer'
    Families(6)=class'XangModFamilyInfo_Mason_ManAtArms'
    Families(7)=class'XangModFamilyInfo_Mason_Vanguard'
    Families(8)=class'XangModFamilyInfo_Mason_Knight'
    Families(9)=class'XangModFamilyInfo_Mason_Assassin'

    MinimumRespawnTime = 10.0f
    MaximumRespawnTime = 10.0f
    bDisableTeamDamagePenalty = true

    //bEnableStatsReporting = false
    //StatsEndpoint = "http://127.0.0.1:3000/api/SlumpStats"
    //StatsServerId = "local-chivalry"
    //StatsReportInterval = 30.0

}

