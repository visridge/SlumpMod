// XANGMOD: Override SprintState to block sprint-off during Grand Lance charge.
// Prevents the player from resetting the sprint speed ramp by tapping the sprint key.
exec function SprintState(optional bool bSprint = false, optional bool bForceToggleSprint)
{
	if (bForceSprintForward && !bSprint)
		return;

	super.SprintState(bSprint, bForceToggleSprint);
}


// XANGMOD: Override ToggleSprint to prevent sprint-off from any source during charge.
function ToggleSprint(bool bSprint, optional bool bForce)
{
	if (bForceSprintForward && !bSprint)
		return;

	super.ToggleSprint(bSprint, bForce);
}


// XANGMOD: Override PerformCrouch to block client-side crouch during Grand Lance charge.
// PerformCrouch intentionally skips the bCanCrouch check (see AOCPawn comment), so without
// this override a held crouch key would set bIsCrouching = true locally each frame even
// though the server correctly rejects it via bCanCrouch. Blocking it here keeps the client
// and server in sync without relying solely on the Tick's bIsCrouching = false correction.
simulated function PerformCrouch(bool bCrouch)
{
	if (bForceSprintForward && bCrouch)
		return;

	super.PerformCrouch(bCrouch);
}


// XANGMOD: Override ModifyVelocity to steer the Grand Lance stab charge in the full 3D
// direction the player is looking — pitch included. Gravity is intentionally suppressed each
// frame by overwriting Velocity (Z included) with the look-direction vector, producing the
// "witch's broom" effect: look up to fly up, look down to dive.
function ModifyVelocity(float DeltaTime, vector OldVelocity)
{
	local vector Forward;
	local float SpeedBefore;

	if (bForceSprintForward)
	{
		if (bIsCrouching)
			ServerPerformCrouch(false);
		RemoveDebuff(EDEBF_CROUCH);

		// Full 3D camera look direction — pitch is kept so vertical steering works.
		Forward = Normal(vector(GetViewRotation()));

		// Align Acceleration with look direction so the native sprint ramp sees forward input.
		Acceleration = Forward * VSize(Acceleration);

		// Capture 3D speed BEFORE super so the broom doesn't lose vertical momentum.
		SpeedBefore = VSize(Acceleration) > 0 ? VSize(Velocity) : GroundSpeed;

		// Let super run (gravity, friction, sprint ramp, etc.).
		super.ModifyVelocity(DeltaTime, OldVelocity);

		// Override full Velocity to the look direction at the captured speed.
		// Intentionally zeroes gravity (Z included) — the broom flies where you aim.
		Velocity = Forward * FMax(SpeedBefore, VSize(Velocity));

		// Keep sprint alive.
		bClientWantsToSprint = true;
	}
	else
	{
		super.ModifyVelocity(DeltaTime, OldVelocity);
	}
}


	/*
