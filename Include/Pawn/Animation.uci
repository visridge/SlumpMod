			//NewReplicatedAnimation.AnimationName = AnimInfo.AlternateAnimation;
		//}
	
	LowerHalfAnimSlot.StopCustomAnim(0.0f);
	TopHalfAnimSlot.StopCustomAnim(0.0f);
	FullBodyAnimSlot.StopCustomAnim(0.0f);
