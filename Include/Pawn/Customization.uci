// XangMod - Customization.uci
// Included via XangModPawn.uci. Vars live in Pawn/Vars.uci; DefaultProperties in Pawn/Camera.uci (last).
/** Apply shield color picker values to the helmet material's PatternColor params */
simulated function ApplyShieldColorsToHelmet()
{
	local MaterialInstanceConstant HelmetMIC;
	local LinearColor LinCol;
	local EAOCFaction TeamID;

	if (WorldInfo.NetMode == NM_DedicatedServer)
		return;

	if (HelmetMeshComp == none || HelmetMeshComp.GetMaterial(0) == none)
		return;

	HelmetMIC = HelmetMeshComp.CreateAndSetMaterialInstanceConstant(0);
	if (HelmetMIC == none)
		return;

	TeamID = GetCustomizationFactionFromActualFaction(PawnFamily.FamilyFaction);

	LinCol = CustomizationClass.static.ConvertTabardColorIndexToLinearColor(PawnInfo.myCustomization.ShieldColor1, TeamID, 0);
	HelmetMIC.SetVectorParameterValue('PatternColor1', LinCol);

	LinCol = CustomizationClass.static.ConvertTabardColorIndexToLinearColor(PawnInfo.myCustomization.ShieldColor2, TeamID, 1);
	HelmetMIC.SetVectorParameterValue('PatternColor2', LinCol);

	LinCol = CustomizationClass.static.ConvertTabardColorIndexToLinearColor(PawnInfo.myCustomization.ShieldColor3, TeamID, 2);
	HelmetMIC.SetVectorParameterValue('PatternColor3', LinCol);
}

/** Override SetupHelmet to apply shield colors to painted helmet materials on spawn/asset load */
simulated function SetupHelmet(int HelmetID, int CharacterID)
{
	super.SetupHelmet(HelmetID, CharacterID);
	ApplyShieldColorsToHelmet();
}

/** Override to also refresh helmet colors whenever shield colors are updated (e.g. customization preview) */
simulated function DisplayCustomizationInfoOnShield()
{
	super.DisplayCustomizationInfoOnShield();
	ApplyShieldColorsToHelmet();
}

simulated function WeaponAttachmentChanged()
{
	super.WeaponAttachmentChanged();

	if (CurrentWeaponAttachment == none)
		return;

	// Re-apply weapon-keyed stat overrides (footman family) after every equip so
	// the movement/stat fields track weapon swaps mid-life.
	ApplyXangModFootmanStats();

	// Force PoleAxeBack to use its own mesh on ALL clients.
	// WeaponEquipping::BeginState runs only on authority/local clients;
	// remote clients get the attachment via replication and need this hook
	// to apply the correct skeletal mesh.
	if (CurrentWeaponAttachment.Class == class'XangModWeaponAttachment_PoleAxeBack')
	{
		CurrentWeaponAttachment.Mesh.SetSkeletalMesh(
			SkeletalMesh'SlumpWep_PaxeBack.SlumpWep_PaxeBack');
		if (CurrentWeaponAttachment.OverlayMesh != none)
			CurrentWeaponAttachment.OverlayMesh.SetSkeletalMesh(
				SkeletalMesh'SlumpWep_PaxeBack.SlumpWep_PaxeBack');
	}

	// XANGMOD: Fix heater shield orientation for javelin — javelin animations
	// hold the arm differently, causing the heater to face skyward like a saucer.
	// Rotate it 90° around Y (yaw) so the shield face points outward instead of upward.
	// if (Weapon != none && StateVariables.bShieldEquipped
	// 	&& (XangModWeapon_JavelinMelee(Weapon) != none || XangModWeapon_HeavyJavelinMelee(Weapon) != none))
	// {
	// 	ShieldMesh.SetRotation(rot(16384, 0, 0));  // 90° yaw — rotates shield face outward
	// 	if (OverlayShieldMesh != none)
	// 		OverlayShieldMesh.SetRotation(rot(16384, 0, 0));
	// }
}

// Override to reset parry box to AOC defaults when XangMod parry box is disabled
simulated function AOCSetCharacterClassFromInfo(AOCFamilyInfo Info)
{
	super.AOCSetCharacterClassFromInfo(Info);

	// NOTE: Do NOT guard on Controller != none here. This function fires during pawn setup,
	// before the controller is associated, so that check would always fail and the reset
	// would never run on the server.
	if (!class'XangModAOCDuelPlayerController'.default.bXangModParryBox)
	{
		// Revert to vanilla AOC parry box dimensions
		ParryComponent.SetScale3D(vect(0.1, 0.17, 0.35));
		ParryComponent.SetTranslation(vect(30, 0, -30));
	}
	else if (class'XangModAOCDuelPlayerController'.default.bSkeletalParry)
	{
		// Skeletal parry: full-body coverage
		ParryComponent.SetScale3D(vect(0.18, 0.17, 0.35));
		ParryComponent.SetTranslation(vect(10, 5, -28));
	}
	// else: XangMod parry enabled, non-skeletal — super already applied FamilyInfo values

	// Apply admin-controlled collision bubble radius (OuterCylinder)
	if (OuterCylinderComp != none)
	{
		OuterCylinderComp.SetCylinderSize(class'XangModAOCDuelPlayerController'.default.fXangModCollisionRadius, 65.0);
	}

	// Weapon-keyed stat override: the footman family re-applies movement/stat fields
	// on top of the real Archer family when a footman primary is equipped.
	ApplyXangModFootmanStats();
}

