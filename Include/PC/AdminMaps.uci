// Switch to CompMod3 server (players without the mod will be kicked and must rejoin manually)
exec function AdminGotoCompMod() {
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminGotoCompMod();
}

reliable server function S_AdminGotoCompMod() {
	if (!IsAdmin()) return;
	S_AdminBroadcastMessage("changed map to AOCFFA-YeedYard_p?modname=CompMod3");
	WorldInfo.ServerTravel("AOCFFA-YeedYard_p?modname=CompMod3", false);
}

