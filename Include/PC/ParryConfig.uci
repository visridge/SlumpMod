// XangMod - ParryConfig.uci
// Included via XangModPlayerController.uci. Vars live in PC/Vars.uci; DefaultProperties in PC/Effects.uci (last).
simulated function SetAllParryBoxClassDefaults(bool bEnableXangMod, bool bEnableSkeletal)
{
	class'XangModAOCDuelPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModAOCDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModCDWDuelPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModCDWDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModCTFPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModCTFPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModFFAPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModFFAPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModKOTHPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModKOTHPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModLTSPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModLTSPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModTDPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModTDPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModTOPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModTOPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'XangModTUTPlayerController'.default.bXangModParryBox = bEnableXangMod;
	class'XangModTUTPlayerController'.default.bSkeletalParry = bEnableSkeletal;
}

// Parry-box hits are traced on the ATTACKER's client, so every pawn on every client needs the server's box.
simulated function ApplyParryBoxSettingsToAllPawns()
{
	local AOCPawn P;
	local vector ParryBoxTranslation;

	foreach WorldInfo.AllPawns(class'AOCPawn', P)
	{
		if (P.ParryComponent == none || P.PawnFamily == none)
			continue;

		if (!class'XangModAOCDuelPlayerController'.default.bXangModParryBox)
		{
			P.ParryComponent.SetScale3D(vect(0.1, 0.17, 0.35));
			P.ParryComponent.SetTranslation(vect(30, 0, -30));
		}
		else if (class'XangModAOCDuelPlayerController'.default.bSkeletalParry)
		{
			P.ParryComponent.SetScale3D(vect(0.32, 0.32, 0.45));
			P.ParryComponent.SetTranslation(vect(0, 0, -45));
		}
		else
		{
			ParryBoxTranslation = P.PawnFamily.ParryBoxTranslation;
			if (AOCWeaponAttachment(P.CurrentWeaponAttachment) != none)
				ParryBoxTranslation += AOCWeaponAttachment(P.CurrentWeaponAttachment).ParryBoxTranslation;
			P.ParryComponent.SetScale3D(P.PawnFamily.ParryBoxScale);
			P.ParryComponent.SetTranslation(ParryBoxTranslation);
		}
	}
}

// Server: push the parry box settings to every player, not just the admin who changed them.
function XangModSyncParryBoxToAll()
{
	local `{GAMEMODE}PlayerController PC;

	foreach WorldInfo.AllControllers(class'`{GAMEMODE}PlayerController', PC)
		PC.ClientSyncParryBoxSettings(class'XangModAOCDuelPlayerController'.default.bXangModParryBox,
			class'XangModAOCDuelPlayerController'.default.bSkeletalParry);
}

// Admin-only visual: shows every pawn's parry box on this client for tuning.
exec function XangModShowParryBoxes(optional bool bShow = true)
{
	local AOCPawn P;

	if (!PlayerReplicationInfo.bAdmin && WorldInfo.NetMode != NM_Standalone)
	{
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}

	foreach WorldInfo.AllPawns(class'AOCPawn', P)
	{
		if (P.ParryComponent == none)
			continue;
		if (bShow)
			P.ParryComponent.SetMaterial(0, Material'CHV_Material_Pack.Materials.Masters.M_Water_Master');
		else
			P.ParryComponent.SetMaterial(0, Material'CHV_stoneshill_lightfx.Materials.Wall.Invisible');
		P.ParryComponent.SetHidden(!bShow);
	}
}

reliable client function ClientSyncParryBoxSettings(bool bEnableXangMod, bool bEnableSkeletal)
{
	bXangModParryBox = bEnableXangMod;
	bSkeletalParry = bEnableSkeletal;
	SetAllParryBoxClassDefaults(bEnableXangMod, bEnableSkeletal);
	ApplyParryBoxSettingsToAllPawns();
}

simulated function SetAllCollisionRadiusClassDefaults(float Radius)
{
	class'XangModAOCDuelPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModCDWDuelPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModCTFPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModFFAPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModKOTHPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModLTSPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModTDPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModTOPlayerController'.default.fXangModCollisionRadius = Radius;
	class'XangModTUTPlayerController'.default.fXangModCollisionRadius = Radius;
}

simulated function ApplyCollisionRadiusToCurrentPawn()
{
	local XangModAOCDuelPawn BMP;

	BMP = XangModAOCDuelPawn(Pawn);
	if (BMP == none || BMP.OuterCylinderComp == none)
		return;

	BMP.OuterCylinderComp.SetCylinderSize(class'XangModAOCDuelPlayerController'.default.fXangModCollisionRadius, 65.0);
}

reliable client function ClientSyncCollisionRadius(float Radius)
{
	fXangModCollisionRadius = Radius;
	SetAllCollisionRadiusClassDefaults(Radius);
	ApplyCollisionRadiusToCurrentPawn();
}

