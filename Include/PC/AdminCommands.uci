		class'XangModAOCDuelPlayerController'.default.bSkeletalParry);
	if (bEnable)
		S_AdminBroadcastMessage("Skeletal parry ENABLED - parry box covers full body (respawn to apply)", false);
	else
		S_AdminBroadcastMessage("Skeletal parry DISABLED - using directional parry box (respawn to apply)", false);
}

