	ServerAdminStartMatch();
}

// Skip the ranked queue countdown; needs an even number of queued players.
reliable server function ServerAdminStartMatch() {
	local string Problem;

	if (!PlayerReplicationInfo.bAdmin)
		return;

	if (XangModLTS(WorldInfo.Game) == none)
		Problem = "Ranked mode is only available on LTS maps.";
	else
		Problem = XangModLTS(WorldInfo.Game).AdminStartRankedMatch();

	if (Problem != "") {
		ClientDisplayConsoleMessage(Problem);
		ReceiveChatMessage(Problem, EFAC_ALL, false, true, class'XangModRanked'.const.CHAT_COLOUR, false);
		return;
	}
	S_AdminBroadcastMessage("AdminStartMatch");
}

