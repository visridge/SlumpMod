	ServerAdminTerminateMatch();
}

// Void the live ranked match, no Elo changes, restart the map.
reliable server function ServerAdminTerminateMatch() {
	if (!PlayerReplicationInfo.bAdmin)
		return;

	if (XangModLTS(WorldInfo.Game) == none || !XangModLTS(WorldInfo.Game).TerminateRankedMatch()) {
		ClientDisplayConsoleMessage("There is no ranked match in progress to terminate.");
		return;
	}
	S_AdminBroadcastMessage("AdminTerminateMatch");
}

