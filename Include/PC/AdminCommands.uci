// Log map changes to chat (chat is mirrored to the in-game console) so everyone
// can see which admin changed the map, and to where.
reliable server function ServerChangeMap(string URL)
{
	if (IsAdmin() && AOCGame(WorldInfo.Game).MapExists(URL))
		S_AdminBroadcastMessage("changed map to "$URL);
	super.ServerChangeMap(URL);
}

// Restart the current map (admin only) and log who did it.
