exec function AdminEnableGoFast(optional bool bEnable = true)
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminEnableGoFast(bEnable);
}

reliable server function S_AdminEnableGoFast(bool bEnable) {
	local AOCFamilyInfo F;

	if (!IsAdmin())
		return;
	class'XangModAOCDuelPlayerController'.default.bXangModGoFast = bEnable;
	class'XangModAOCDuelPlayerController'.static.StaticSaveConfig();
	foreach WorldInfo.AllActors(class'AOCFamilyInfo', F)
		class'XangModAdminActions'.static.ApplyGoFast(F);
	if (bEnable)
		S_AdminBroadcastMessage("GoFast ENABLED - faster sprint ramp-up (MAA -50%, Vanguard -35%, Knight -20%)", false);
	else
		S_AdminBroadcastMessage("GoFast DISABLED - vanilla sprint ramp-up", false);
}

exec function AdminSetCollisionRadius(float NewRadius)
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminSetCollisionRadius(NewRadius);
}

reliable server function S_AdminSetCollisionRadius(float NewRadius) {
	local AOCPlayerController PC;

	if (!IsAdmin())
		return;

	// Clamp to a sane range to prevent griefing (1 to 200)
	NewRadius = FClamp(NewRadius, 1.0, 200.0);

	class'XangModAOCDuelPlayerController'.default.fXangModCollisionRadius = NewRadius;
	class'XangModAOCDuelPlayerController'.static.StaticSaveConfig();

	// Sync all connected players
	foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
	{
		if (XangModAOCDuelPlayerController(PC) != none)
			XangModAOCDuelPlayerController(PC).ClientSyncCollisionRadius(NewRadius);
	}

	S_AdminBroadcastMessage("Collision bubble radius set to" @ NewRadius @ "(respawn to apply)", false);
}

// CE Autoskip: auto-fires "ce skip" when TO timer reaches 5 seconds
exec function AdminCEAutoskip()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminCEAutoskip();
}

reliable server function S_AdminCEAutoskip() {
	local XangModTO TOGame;

	if (!IsAdmin())
		return;

	TOGame = XangModTO(WorldInfo.Game);
	if (TOGame == none) {
		ClientDisplayConsoleMessage("CE Autoskip only works in Team Objective.");
		return;
	}

	TOGame.bCEAutoskipEnabled = !TOGame.bCEAutoskipEnabled;
	TOGame.bCEAutoskipFired = false;
	if (TOGame.bCEAutoskipEnabled)
		S_AdminBroadcastMessage("CE Autoskip ENABLED (auto-skip at 5s)", false);
	else
		S_AdminBroadcastMessage("CE Autoskip DISABLED", false);
}

// Bot King on/off for this match. No argument toggles. Works before or during the King stage.
exec function AdminAIKing(optional string OnOff)
{
	if (!PlayerReplicationInfo.bAdmin && WorldInfo.NetMode != NM_Standalone) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminAIKing(OnOff);
}

reliable server function S_AdminAIKing(string OnOff) {
	local XangModTO TOGame;
	local bool bOn;

	if (!IsAdmin())
		return;
	TOGame = XangModTO(WorldInfo.Game);
	if (TOGame == none) {
		ClientDisplayConsoleMessage("Bot King only applies to Team Objective.");
		return;
	}
	if (OnOff ~= "on" || OnOff ~= "1" || OnOff ~= "true")
		bOn = true;
	else if (OnOff ~= "off" || OnOff ~= "0" || OnOff ~= "false")
		bOn = false;
	else
		bOn = !TOGame.XangModUsesAIKing();
	S_AdminBroadcastMessage(TOGame.XangModSetAIKing(bOn), false);
}

// Completes the current TO stage; the map advances itself and the skipped stage awards no bonus time.
exec function AdminSkipObjective()
{
	if (!PlayerReplicationInfo.bAdmin && WorldInfo.NetMode != NM_Standalone) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminSkipObjective();
}

reliable server function S_AdminSkipObjective() {
	local XangModTO TOGame;

	if (!IsAdmin())
		return;

	TOGame = XangModTO(WorldInfo.Game);
	if (TOGame == none) {
		ClientDisplayConsoleMessage("Objective skip only works in Team Objective.");
		return;
	}

	if (TOGame.XangModSkipObjective())
		S_AdminBroadcastMessage("skipped the current objective");
	else
		ClientDisplayConsoleMessage("No active objective to skip.");
}

exec function AdminCompForestAlternatingSpawns(optional bool bEnable = true)
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminCompForestAlternatingSpawns(bEnable);
}

reliable server function S_AdminCompForestAlternatingSpawns(bool bEnable)
{
	local XangModTO TOGame;

	if (!IsAdmin())
		return;

	TOGame = XangModTO(WorldInfo.Game);
	if (TOGame == none || !TOGame.XangModIsCompForestTO()) {
		ClientDisplayConsoleMessage("CompForest alternating spawns only work on AOCTO-CompForest_p.");
		return;
	}

	TOGame.bEnableCompForestAlternatingSpawns = bEnable;
	TOGame.iXangModCompForestLastStage = -1;
	TOGame.iXangModCompForestLastAgathaGroup = -1;
	TOGame.iXangModCompForestLastMasonGroup = -1;

	if (bEnable)
		S_AdminBroadcastMessage("CompForest alternating spawns ENABLED", false);
	else
		S_AdminBroadcastMessage("CompForest alternating spawns DISABLED", false);
}

// Option A: Reset ALL physics volumes to default friction (nuclear)
exec function AdminResetAllTraction()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminResetAllTraction();
}

reliable server function S_AdminResetAllTraction() {
	local PhysicsVolume PV;
	local int Count;

	if (!IsAdmin())
		return;

	foreach AllActors(class'PhysicsVolume', PV)
	{
		if (PV.GroundFriction != 8.0)
		{
			PV.GroundFriction = 8.0;
			Count++;
		}
	}
	S_AdminBroadcastMessage("Reset traction on" @ Count @ "physics volumes (Option A - all volumes)", false);
}

// Option C: Reset only non-water low-friction volumes (selective)
exec function AdminResetIceTraction()
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminResetIceTraction();
}

reliable server function S_AdminResetIceTraction() {
	local PhysicsVolume PV;
	local int Count;

	if (!IsAdmin())
		return;

	foreach AllActors(class'PhysicsVolume', PV)
	{
		if (PV.GroundFriction < 8.0 && !PV.bWaterVolume)
		{
			PV.GroundFriction = 8.0;
			Count++;
		}
	}
	S_AdminBroadcastMessage("Reset ice traction on" @ Count @ "physics volumes (Option C - non-water only)", false);
}

