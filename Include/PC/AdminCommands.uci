exec function AdminRConStatus() {
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	ServerAdminRConStatus();
}

// Listener state, every RCON session and recent rejected logins, to this admin's console.
reliable server function ServerAdminRConStatus() {
	local XangModRCon RCon;
	local array<string> Lines;
	local string Line;

	if (!PlayerReplicationInfo.bAdmin)
		return;

	foreach WorldInfo.AllActors(class'XangModRCon', RCon) {
		if (XangModRConSession(RCon) == none) {
			RCon.XangModStatusLines(Lines);
			break;
		}
	}
	if (Lines.Length == 0)
		Lines.AddItem("No XangMod RCON listener on this server.");

	foreach Lines(Line)
		ClientDisplayConsoleMessage(Line);
}

