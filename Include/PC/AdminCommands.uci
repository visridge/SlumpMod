// Override AdminLoginHidden to prevent silent admin logins on XangMod servers.
// Redirects to the standard AdminLogin which broadcasts to all players.
exec function AdminLoginHidden(string Password)
{
	AdminLogin(Password);
}

reliable server function ServerAdminLoginHidden(string Password)
{
	// Intentionally disabled - use ServerAdminLogin instead (broadcasts to server)
}

exec function AdminToggleParryBox(optional bool bEnable = true)
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminToggleParryBox(bEnable);
}

reliable server function S_AdminToggleParryBox(bool bEnable) {
	if (!IsAdmin())
		return;
	// Must set on the class default — pawn reads class'XangModAOCDuelPlayerController'.default.bXangModParryBox
	class'XangModAOCDuelPlayerController'.default.bXangModParryBox = bEnable;
	class'XangModAOCDuelPlayerController'.static.StaticSaveConfig();
	ClientSyncParryBoxSettings(class'XangModAOCDuelPlayerController'.default.bXangModParryBox,
		class'XangModAOCDuelPlayerController'.default.bSkeletalParry);
	if (bEnable)
		S_AdminBroadcastMessage("XangMod parry box ENABLED (respawn to apply)", false);
	else
		S_AdminBroadcastMessage("XangMod parry box DISABLED - using vanilla AOC parry box (respawn to apply)", false);
}

exec function AdminEnableSkeletalParry(optional bool bEnable = true)
{
	if (!PlayerReplicationInfo.bAdmin) {
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}
	S_AdminEnableSkeletalParry(bEnable);
}

reliable server function S_AdminEnableSkeletalParry(bool bEnable) {
	if (!IsAdmin())
		return;
	class'XangModAOCDuelPlayerController'.default.bSkeletalParry = bEnable;
	class'XangModAOCDuelPlayerController'.static.StaticSaveConfig();
